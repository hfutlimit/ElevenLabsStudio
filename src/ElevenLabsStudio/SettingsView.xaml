<Window x:Class="ElevenLabsStudio.Views.SettingsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:cal="http://www.caliburnproject.org"
        mc:Ignorable="d"
        Title="Settings · ElevenLabs Studio"
        Height="540" Width="620"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource App.Canvas}"
        TextElement.Foreground="{StaticResource App.Text}"
        FontFamily="{DynamicResource MaterialDesign.Font}">
    <Border Style="{StaticResource App.ElevatedCard}"
            Margin="18">
        <Grid Margin="24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="Settings"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource App.Text}" />
                <TextBlock Text="Connect to ElevenLabs and configure how the app runs"
                           FontSize="11"
                           Foreground="{StaticResource App.TextMuted}"
                           Margin="0,3,0,0" />
            </StackPanel>

            <!-- Api key -->
            <Border Grid.Row="1"
                    Style="{StaticResource App.SectionCard}"
                    Padding="16"
                    Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="ElevenLabs API Key"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10"
                               Foreground="{StaticResource App.Text}" />
                    <PasswordBox x:Name="ApiKey"
                                 Height="40"
                                 FontSize="13"
                                 Padding="11,7"
                                 BorderBrush="{StaticResource App.Border}"
                                 Background="{StaticResource App.Surface}"
                                 Foreground="{StaticResource App.Text}" />
                    <TextBlock Text="You can also use the ELEVENLABS_API_KEY environment variable"
                               FontSize="11"
                               Foreground="{StaticResource App.TextMuted}"
                               Margin="0,7,0,0" />
                </StackPanel>
            </Border>

            <!-- Mock mode -->
            <Border Grid.Row="2"
                    Style="{StaticResource App.SectionCard}"
                    Padding="16">
                <StackPanel>
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Style="{StaticResource App.Badge}">
                            <TextBlock x:Name="MockBadge"
                                       FontSize="11"
                                       Foreground="{StaticResource App.TextSecondary}"
                                       Text="{Binding MockBadgeText}" />
                        </Border>
                        <TextBlock Text="Data source"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource App.Text}" />
                    </DockPanel>
                    <CheckBox x:Name="MockMode"
                              Content="Use offline mock data (no API key required)"
                              Margin="0,12,0,0"
                              FontSize="12"
                              Foreground="{StaticResource App.Text}" />
                    <TextBlock Text="When disabled, the app uses the API key above to access api.elevenlabs.io."
                               FontSize="11"
                               Foreground="{StaticResource App.TextSecondary}"
                               Margin="24,5,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Error / status -->
            <TextBlock Grid.Row="3"
                       x:Name="StatusText"
                       FontSize="11"
                       Foreground="{StaticResource App.Danger}"
                       Margin="2,12,0,0"
                       TextWrapping="Wrap" />

            <!-- Footer buttons -->
            <StackPanel Grid.Row="4"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,16,0,0">
                <Button x:Name="Cancel"
                        cal:Message.Attach="[Event Click] = [Action CancelAsync()]"
                        Style="{StaticResource App.SecondaryButton}"
                        Content="Cancel"
                        Width="92"
                        Margin="0,0,10,0" />
                <Button x:Name="Save"
                        cal:Message.Attach="[Event Click] = [Action SaveAsync()]"
                        Style="{StaticResource App.PrimaryButton}"
                        Content="Save"
                        Width="92" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
