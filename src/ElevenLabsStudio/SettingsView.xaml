<Window x:Class="ElevenLabsStudio.Views.SettingsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:cal="http://www.caliburnproject.org"
        mc:Ignorable="d"
        Title="设置 · ElevenLabs Studio"
        Height="520" Width="560"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource App.Surface}"
        TextElement.Foreground="{StaticResource App.Text}"
        FontFamily="{DynamicResource MaterialDesign.Font}">
    <Border BorderBrush="{StaticResource App.Border}"
            BorderThickness="1"
            Background="{StaticResource App.Surface}">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="设置"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource App.Text}" />
                <TextBlock Text="保存后写入 appsettings.json 并立即热重载，无需重启。"
                           FontSize="11"
                           Foreground="{StaticResource App.TextMuted}"
                           Margin="0,4,0,0" />
            </StackPanel>

            <!-- Api key -->
            <StackPanel Grid.Row="1" Margin="0,0,0,18">
                <TextBlock Text="ElevenLabs API Key"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource App.TextSecondary}"
                           Margin="0,0,0,6" />
                <PasswordBox x:Name="ApiKey"
                             Height="36"
                             FontSize="13"
                             Padding="10,6"
                             BorderBrush="{StaticResource App.BorderStrong}"
                             Background="{StaticResource App.Surface}"
                             Foreground="{StaticResource App.Text}" />
                <TextBlock Text="也可以通过环境变量 ELEVENLABS_API_KEY 设置。"
                           FontSize="10"
                           Foreground="{StaticResource App.TextMuted}"
                           Margin="0,4,0,0" />
            </StackPanel>

            <!-- Mock mode -->
            <Border Grid.Row="2"
                    BorderBrush="{StaticResource App.Border}"
                    BorderThickness="1"
                    Background="{StaticResource App.SurfaceAlt}"
                    Padding="14"
                    CornerRadius="4">
                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right"
                                   x:Name="MockBadge"
                                   Padding="6,2"
                                   FontSize="10"
                                   Background="{StaticResource App.AccentSoft}"
                                   Foreground="{StaticResource App.Accent}"
                                   Text="{Binding MockBadgeText}" />
                        <TextBlock Text="Mock 模式"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource App.Text}" />
                    </DockPanel>
                    <CheckBox x:Name="MockMode"
                              Content="使用离线 Mock 数据（无需 API Key）"
                              Margin="0,8,0,0"
                              FontSize="12"
                              Foreground="{StaticResource App.Text}" />
                    <TextBlock Text="关闭后，应用将使用上方 API Key 访问 api.elevenlabs.io。"
                               FontSize="11"
                               Foreground="{StaticResource App.TextSecondary}"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Error / status -->
            <TextBlock Grid.Row="3"
                       x:Name="StatusText"
                       FontSize="11"
                       Foreground="{StaticResource App.Danger}"
                       Margin="0,12,0,0"
                       TextWrapping="Wrap" />

            <!-- Footer buttons -->
            <StackPanel Grid.Row="4"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,16,0,0">
                <Button x:Name="Cancel"
                        cal:Message.Attach="[Event Click] = [Action CancelAsync()]"
                        Content="取消"
                        Width="90" Height="34"
                        Margin="0,0,8,0"
                        Background="{StaticResource App.SurfaceAlt}"
                        Foreground="{StaticResource App.Text}"
                        BorderBrush="{StaticResource App.BorderStrong}" />
                <Button x:Name="Save"
                        cal:Message.Attach="[Event Click] = [Action SaveAsync()]"
                        Content="保存"
                        Width="90" Height="34"
                        Background="{StaticResource App.Accent}"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="SemiBold" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
