<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">

	<!-- Layered neutral palette with a restrained indigo accent. -->
	<SolidColorBrush x:Key="App.Canvas" Color="#F2F4F8" />
	<SolidColorBrush x:Key="App.Surface" Color="#FFFFFF" />
	<SolidColorBrush x:Key="App.SurfaceAlt" Color="#F7F8FB" />
	<SolidColorBrush x:Key="App.SurfaceHover" Color="#EEF1F6" />
	<SolidColorBrush x:Key="App.SurfacePressed" Color="#E5E9F1" />
	<SolidColorBrush x:Key="App.Border" Color="#D6DCE6" />
	<SolidColorBrush x:Key="App.BorderEmphasis" Color="#AEB8C7" />
	<SolidColorBrush x:Key="App.BorderStrong" Color="#7B879A" />
	<SolidColorBrush x:Key="App.Text" Color="#182033" />
	<SolidColorBrush x:Key="App.TextSecondary" Color="#566176" />
	<SolidColorBrush x:Key="App.TextMuted" Color="#667085" />
	<SolidColorBrush x:Key="App.Accent" Color="#4F46D8" />
	<SolidColorBrush x:Key="App.AccentHover" Color="#4239C5" />
	<SolidColorBrush x:Key="App.AccentSoft" Color="#EEEDFF" />
	<SolidColorBrush x:Key="App.AccentBorder" Color="#C9C6FF" />
	<SolidColorBrush x:Key="App.Success" Color="#148A68" />
	<SolidColorBrush x:Key="App.SuccessSoft" Color="#E8F7F1" />
	<SolidColorBrush x:Key="App.Warning" Color="#B86A12" />
	<SolidColorBrush x:Key="App.Danger" Color="#CF4650" />
	<SolidColorBrush x:Key="App.DangerHover" Color="#B93641" />
	<SolidColorBrush x:Key="App.DangerSoft" Color="#FFF0F1" />

	<DropShadowEffect x:Key="App.CardShadow"
					  Color="#667085"
					  BlurRadius="20"
					  ShadowDepth="4"
					  Direction="270"
					  Opacity="0.12" />
	<DropShadowEffect x:Key="App.WindowShadow"
					  Color="#344054"
					  BlurRadius="28"
					  ShadowDepth="6"
					  Direction="270"
					  Opacity="0.18" />

	<Style x:Key="App.ElevatedCard" TargetType="Border">
		<Setter Property="Background" Value="{StaticResource App.Surface}" />
		<Setter Property="BorderBrush" Value="{StaticResource App.Border}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="CornerRadius" Value="12" />
		<Setter Property="Effect" Value="{StaticResource App.CardShadow}" />
	</Style>

	<Style x:Key="App.SectionCard" TargetType="Border">
		<Setter Property="Background" Value="{StaticResource App.SurfaceAlt}" />
		<Setter Property="BorderBrush" Value="{StaticResource App.Border}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="CornerRadius" Value="10" />
	</Style>

	<Style x:Key="App.SoftCard"
		   TargetType="Border"
		   BasedOn="{StaticResource App.SectionCard}" />

	<Style x:Key="App.Badge" TargetType="Border">
		<Setter Property="CornerRadius" Value="10" />
		<Setter Property="Padding" Value="8,3" />
		<Setter Property="Background" Value="{StaticResource App.AccentSoft}" />
		<Setter Property="BorderBrush" Value="{StaticResource App.AccentBorder}" />
		<Setter Property="BorderThickness" Value="1" />
	</Style>

	<Style x:Key="App.FocusVisual" TargetType="Control">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate>
					<Rectangle Margin="-3"
							   RadiusX="10"
							   RadiusY="10"
							   Stroke="{StaticResource App.Accent}"
							   StrokeThickness="2"
							   SnapsToDevicePixels="True" />
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="App.ButtonBase" TargetType="Button">
		<Setter Property="Height" Value="36" />
		<Setter Property="MinWidth" Value="36" />
		<Setter Property="Padding" Value="14,0" />
		<Setter Property="FontSize" Value="12" />
		<Setter Property="FontWeight" Value="SemiBold" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="FocusVisualStyle" Value="{StaticResource App.FocusVisual}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Border x:Name="Chrome"
							Background="{TemplateBinding Background}"
							BorderBrush="{TemplateBinding BorderBrush}"
							BorderThickness="{TemplateBinding BorderThickness}"
							CornerRadius="8"
							SnapsToDevicePixels="True">
						<ContentPresenter HorizontalAlignment="Center"
									  VerticalAlignment="Center"
									  Margin="{TemplateBinding Padding}"
									  RecognizesAccessKey="True" />
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Chrome" Property="Opacity" Value="0.9" />
						</Trigger>
						<Trigger Property="IsPressed" Value="True">
							<Setter TargetName="Chrome" Property="Opacity" Value="0.78" />
						</Trigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter TargetName="Chrome" Property="Opacity" Value="0.46" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="App.PrimaryButton"
		   TargetType="Button"
		   BasedOn="{StaticResource App.ButtonBase}">
		<Setter Property="Background" Value="{StaticResource App.Accent}" />
		<Setter Property="BorderBrush" Value="{StaticResource App.Accent}" />
		<Setter Property="Foreground" Value="White" />
	</Style>

	<Style x:Key="App.SecondaryButton"
		   TargetType="Button"
		   BasedOn="{StaticResource App.ButtonBase}">
		<Setter Property="Background" Value="{StaticResource App.Surface}" />
		<Setter Property="BorderBrush" Value="{StaticResource App.BorderStrong}" />
		<Setter Property="Foreground" Value="{StaticResource App.Text}" />
	</Style>

	<Style x:Key="App.GhostButton"
		   TargetType="Button"
		   BasedOn="{StaticResource App.ButtonBase}">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderBrush" Value="Transparent" />
		<Setter Property="Foreground" Value="{StaticResource App.TextSecondary}" />
	</Style>

	<Style x:Key="App.IconButton"
		   TargetType="Button"
		   BasedOn="{StaticResource App.GhostButton}">
		<Setter Property="Width" Value="36" />
		<Setter Property="Padding" Value="0" />
	</Style>

	<Style x:Key="CaptionButton"
		   TargetType="Button"
		   BasedOn="{StaticResource App.IconButton}">
		<Setter Property="Width" Value="46" />
		<Setter Property="Height" Value="46" />
		<Setter Property="Cursor" Value="Arrow" />
		<Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
	</Style>

	<Style x:Key="App.TabItem" TargetType="TabItem">
		<Setter Property="Foreground" Value="{StaticResource App.TextSecondary}" />
		<Setter Property="FontSize" Value="12" />
		<Setter Property="FontWeight" Value="SemiBold" />
		<Setter Property="Margin" Value="0,0,6,0" />
		<Setter Property="Padding" Value="12,8" />
		<Setter Property="FocusVisualStyle" Value="{StaticResource App.FocusVisual}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="TabItem">
					<Border x:Name="Chrome"
							Background="Transparent"
							BorderBrush="Transparent"
							BorderThickness="1"
							CornerRadius="8"
							Padding="{TemplateBinding Padding}">
						<ContentPresenter ContentSource="Header"
									  HorizontalAlignment="Center"
									  VerticalAlignment="Center" />
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Chrome" Property="Background" Value="{StaticResource App.SurfaceHover}" />
						</Trigger>
						<Trigger Property="IsSelected" Value="True">
							<Setter TargetName="Chrome" Property="Background" Value="{StaticResource App.AccentSoft}" />
							<Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource App.AccentBorder}" />
							<Setter Property="Foreground" Value="{StaticResource App.Accent}" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="App.DataGrid" TargetType="DataGrid">
		<Setter Property="Background" Value="{StaticResource App.Surface}" />
		<Setter Property="BorderBrush" Value="{StaticResource App.Border}" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="GridLinesVisibility" Value="Horizontal" />
		<Setter Property="HorizontalGridLinesBrush" Value="{StaticResource App.Border}" />
		<Setter Property="RowBackground" Value="{StaticResource App.Surface}" />
		<Setter Property="AlternatingRowBackground" Value="{StaticResource App.SurfaceAlt}" />
		<Setter Property="RowHeaderWidth" Value="0" />
		<Setter Property="HeadersVisibility" Value="Column" />
		<Setter Property="CanUserAddRows" Value="False" />
		<Setter Property="AutoGenerateColumns" Value="False" />
	</Style>
</ResourceDictionary>
