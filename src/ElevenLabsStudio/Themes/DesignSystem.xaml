<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">

	<!-- ============================================================
	     Palette — studio-harmony (docs/prototypes/studio-harmony).
	     Warm white paper + a single gray-green signal, layered with
	     1px hairlines instead of tinted card stacks. Every key below
	     is shared by the whole app, so re-skinning means editing these
	     values, not the views.

	     Legacy keys (App.Accent / App.Border / App.TextSecondary /
	     App.TextMuted / App.SurfaceAlt / App.AccentSoft /
	     App.AccentBorder) are kept as aliases pointed at the new
	     palette so older views and VisualPolishTests still resolve
	     them — but they now carry the warm/green tones.

	     Source tokens (CSS custom properties in the prototype):
	     bg #ffffff, side #f5f6f2, tint #fafbf8, ink #29322e,
	     secondary #6f7973, muted #89938c, line #e5e9e2, green #3d654d,
	     green-soft #e8eee3, amber #ad803e.
	     ============================================================ -->

	<!-- Neutrals. Canvas == Surface == paper white; the sidebar and
	     tinted toolbars carry their own warmer tones. -->
	<SolidColorBrush x:Key="App.Canvas" Color="#FFFFFF" />
	<SolidColorBrush x:Key="App.Surface" Color="#FFFFFF" />
	<SolidColorBrush x:Key="App.Side" Color="#F5F6F2" />
	<SolidColorBrush x:Key="App.Tint" Color="#FAFBF8" />
	<SolidColorBrush x:Key="App.SurfaceAlt" Color="#FAFBF8" />
	<SolidColorBrush x:Key="App.SurfaceHover" Color="#ECEFE7" />
	<SolidColorBrush x:Key="App.SurfacePressed" Color="#E3E7DD" />

	<!-- Hairlines. Non-interactive separation is a light rule; the
	     slightly stronger Frame/BorderStrong carry input outlines. -->
	<SolidColorBrush x:Key="App.Line" Color="#E5E9E2" />
	<SolidColorBrush x:Key="App.LineSoft" Color="#EEF0EA" />
	<SolidColorBrush x:Key="App.Frame" Color="#DFE5DA" />
	<SolidColorBrush x:Key="App.Border" Color="#E5E9E2" />
	<SolidColorBrush x:Key="App.BorderEmphasis" Color="#DFE5DA" />
	<SolidColorBrush x:Key="App.BorderStrong" Color="#AEBBA6" />

	<!-- Ink ramp. TextMuted/Ink3 sit at the prototype's secondary tone so
	     small metadata still clears AA on white; ultra-muted mono IDs
	     reuse App.Ink4. -->
	<SolidColorBrush x:Key="App.Ink" Color="#29322E" />
	<SolidColorBrush x:Key="App.Text" Color="#29322E" />
	<SolidColorBrush x:Key="App.Ink2" Color="#5F6B64" />
	<SolidColorBrush x:Key="App.TextSecondary" Color="#5F6B64" />
	<SolidColorBrush x:Key="App.Ink3" Color="#6B746C" />
	<SolidColorBrush x:Key="App.TextMuted" Color="#6B746C" />
	<SolidColorBrush x:Key="App.Ink4" Color="#89938C" />

	<!-- Signal — the single gray-green accent. -->
	<SolidColorBrush x:Key="App.Signal" Color="#3D654D" />
	<SolidColorBrush x:Key="App.SignalHover" Color="#2C503B" />
	<SolidColorBrush x:Key="App.SignalWash" Color="#E8EEE3" />
	<SolidColorBrush x:Key="App.Accent" Color="#3D654D" />
	<SolidColorBrush x:Key="App.AccentHover" Color="#2C503B" />
	<SolidColorBrush x:Key="App.AccentSoft" Color="#E8EEE3" />
	<SolidColorBrush x:Key="App.AccentBorder" Color="#DEE5D9" />

	<!-- Status. Success is a leaf green; Warning is the prototype's
	     amber "dirty" cue; Danger is a warm brick that reads against
	     the green without colliding with it. -->
	<SolidColorBrush x:Key="App.Success" Color="#4A7355" />
	<SolidColorBrush x:Key="App.SuccessSoft" Color="#E8EEE3" />
	<SolidColorBrush x:Key="App.Warning" Color="#AD803E" />
	<SolidColorBrush x:Key="App.Danger" Color="#A8453B" />
	<SolidColorBrush x:Key="App.DangerHover" Color="#8E382F" />
	<SolidColorBrush x:Key="App.DangerSoft" Color="#F6ECEA" />

	<!-- Radii vocabulary: rail/window 8, control 6, badge 4,
	     selection bar 1. Card-in-card radii (12) are gone. -->

	<!-- Typography. studio-harmony pairs a humanist UI face with a
	     coding mono; both are exposed as tokens so views stop hardcoding
	     the family string. -->
	<FontFamily x:Key="App.UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
	<FontFamily x:Key="App.MonoFont">Cascadia Code, Consolas, monospace</FontFamily>

	<Style x:Key="App.Eyebrow" TargetType="TextBlock">
		<Setter Property="FontSize" Value="10.5" />
		<Setter Property="FontWeight" Value="Bold" />
		<Setter Property="Foreground" Value="{StaticResource App.Ink3}" />
		<Setter Property="TextBlock.TextDecorations" Value="{x:Null}" />
	</Style>

	<Style x:Key="App.Mono" TargetType="TextBlock">
		<Setter Property="FontFamily" Value="Consolas, Cascadia Mono, monospace" />
		<Setter Property="FontSize" Value="11" />
		<Setter Property="Foreground" Value="{StaticResource App.Ink3}" />
	</Style>

	<!-- A pane that used to be a shadowed "card". Now it is just a
	     hairline frame; the shadow lives only on true overlays. -->
	<Style x:Key="App.ElevatedCard" TargetType="Border">
		<Setter Property="Background" Value="{StaticResource App.Surface}" />
		<Setter Property="BorderBrush" Value="{StaticResource App.Line}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="CornerRadius" Value="8" />
	</Style>

	<!-- Kept as a marker for old views; new code should draw a hairline
	     directly. Zero visual weight. -->
	<Style x:Key="App.SectionCard" TargetType="Border">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderBrush" Value="Transparent" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="CornerRadius" Value="6" />
	</Style>

	<Style x:Key="App.SoftCard"
		   TargetType="Border"
		   BasedOn="{StaticResource App.SectionCard}" />

	<Style x:Key="App.Badge" TargetType="Border">
		<Setter Property="CornerRadius" Value="4" />
		<Setter Property="Padding" Value="7,2" />
		<Setter Property="Background" Value="{StaticResource App.SurfaceHover}" />
		<Setter Property="BorderBrush" Value="{StaticResource App.Line}" />
		<Setter Property="BorderThickness" Value="1" />
	</Style>

	<Style x:Key="App.FocusVisual" TargetType="Control">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate>
					<Rectangle Margin="-3"
							   RadiusX="6"
							   RadiusY="6"
							   Stroke="{StaticResource App.Signal}"
							   StrokeThickness="2"
							   SnapsToDevicePixels="True" />
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="App.ButtonBase" TargetType="Button">
		<Setter Property="Height" Value="31" />
		<Setter Property="MinWidth" Value="31" />
		<Setter Property="Padding" Value="14,0" />
		<Setter Property="FontSize" Value="12.5" />
		<Setter Property="FontWeight" Value="SemiBold" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="FocusVisualStyle" Value="{StaticResource App.FocusVisual}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Border x:Name="Chrome"
							Background="{TemplateBinding Background}"
							BorderBrush="{TemplateBinding BorderBrush}"
							BorderThickness="{TemplateBinding BorderThickness}"
							CornerRadius="6"
							SnapsToDevicePixels="True">
						<ContentPresenter HorizontalAlignment="Center"
										  VerticalAlignment="Center"
										  Margin="{TemplateBinding Padding}"
										  RecognizesAccessKey="True" />
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsEnabled" Value="False">
							<Setter TargetName="Chrome" Property="Opacity" Value="0.42" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="App.PrimaryButton"
		   TargetType="Button"
		   BasedOn="{StaticResource App.ButtonBase}">
		<Setter Property="Background" Value="{StaticResource App.Signal}" />
		<Setter Property="BorderBrush" Value="{StaticResource App.Signal}" />
		<Setter Property="Foreground" Value="White" />
		<Style.Triggers>
			<Trigger Property="IsMouseOver" Value="True">
				<Setter Property="Background" Value="{StaticResource App.SignalHover}" />
				<Setter Property="BorderBrush" Value="{StaticResource App.SignalHover}" />
			</Trigger>
			<Trigger Property="IsPressed" Value="True">
				<Setter Property="Background" Value="{StaticResource App.SignalHover}" />
				<Setter Property="Opacity" Value="0.9" />
			</Trigger>
		</Style.Triggers>
	</Style>

	<Style x:Key="App.SecondaryButton"
		   TargetType="Button"
		   BasedOn="{StaticResource App.ButtonBase}">
		<Setter Property="Background" Value="{StaticResource App.Surface}" />
		<Setter Property="BorderBrush" Value="{StaticResource App.BorderEmphasis}" />
		<Setter Property="Foreground" Value="{StaticResource App.Text}" />
		<Style.Triggers>
			<Trigger Property="IsMouseOver" Value="True">
				<Setter Property="Background" Value="{StaticResource App.SurfaceHover}" />
				<Setter Property="BorderBrush" Value="{StaticResource App.BorderStrong}" />
			</Trigger>
			<Trigger Property="IsPressed" Value="True">
				<Setter Property="Background" Value="{StaticResource App.SurfacePressed}" />
				<Setter Property="Opacity" Value="0.9" />
			</Trigger>
		</Style.Triggers>
	</Style>

	<Style x:Key="App.GhostButton"
		   TargetType="Button"
		   BasedOn="{StaticResource App.ButtonBase}">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderBrush" Value="Transparent" />
		<Setter Property="Foreground" Value="{StaticResource App.Ink2}" />
		<Style.Triggers>
			<Trigger Property="IsMouseOver" Value="True">
				<Setter Property="Background" Value="{StaticResource App.SurfaceHover}" />
				<Setter Property="Foreground" Value="{StaticResource App.Text}" />
			</Trigger>
			<Trigger Property="IsPressed" Value="True">
				<Setter Property="Background" Value="{StaticResource App.SurfacePressed}" />
				<Setter Property="Opacity" Value="0.9" />
			</Trigger>
		</Style.Triggers>
	</Style>

	<!-- Icon-only action button. It MUST read as a button: a solid
	     surface body + hairline border is the minimum affordance for a
	     glyph floating on the canvas. Inheriting GhostButton (fully
	     transparent) made the sidebar collapse + and import + look like
	     decorative marks nobody would click. -->
	<Style x:Key="App.IconButton"
		   TargetType="Button"
		   BasedOn="{StaticResource App.ButtonBase}">
		<Setter Property="Width" Value="28" />
		<Setter Property="Height" Value="28" />
		<Setter Property="MinWidth" Value="28" />
		<Setter Property="Padding" Value="0" />
		<Setter Property="Background" Value="{StaticResource App.Surface}" />
		<Setter Property="BorderBrush" Value="{StaticResource App.BorderEmphasis}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="Foreground" Value="{StaticResource App.Ink2}" />
		<Style.Triggers>
			<Trigger Property="IsMouseOver" Value="True">
				<Setter Property="Background" Value="{StaticResource App.SignalWash}" />
				<Setter Property="BorderBrush" Value="{StaticResource App.Signal}" />
				<Setter Property="Foreground" Value="{StaticResource App.Signal}" />
			</Trigger>
			<Trigger Property="IsPressed" Value="True">
				<Setter Property="Background" Value="{StaticResource App.SurfacePressed}" />
				<Setter Property="BorderBrush" Value="{StaticResource App.SignalHover}" />
			</Trigger>
		</Style.Triggers>
	</Style>

	<Style x:Key="CaptionButton"
		   TargetType="Button"
		   BasedOn="{StaticResource App.GhostButton}">
		<Setter Property="Width" Value="46" />
		<Setter Property="Height" Value="46" />
		<Setter Property="Padding" Value="0" />
		<Setter Property="Cursor" Value="Arrow" />
		<Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
	</Style>

	<!-- Close: neutral until hovered, then a solid danger block with a
	     white glyph — the Windows convention. A permanently-red X just
	     reads as noise next to the other three. -->
	<Style x:Key="CloseCaptionButton"
		   TargetType="Button"
		   BasedOn="{StaticResource CaptionButton}">
		<Style.Triggers>
			<Trigger Property="IsMouseOver" Value="True">
				<Setter Property="Background" Value="{StaticResource App.Danger}" />
				<Setter Property="BorderBrush" Value="{StaticResource App.Danger}" />
				<Setter Property="Foreground" Value="White" />
			</Trigger>
		</Style.Triggers>
	</Style>

	<!-- Underline tab. Text only; the selection cue is a 2px signal
	     rule on the bottom edge, so the TabControl's own bottom hairline
	     can act as the full-width baseline. -->
	<Style x:Key="App.TabItem" TargetType="TabItem">
		<Setter Property="Foreground" Value="{StaticResource App.Ink2}" />
		<Setter Property="FontSize" Value="13" />
		<Setter Property="FontWeight" Value="Medium" />
		<Setter Property="Padding" Value="0,9,0,11" />
		<Setter Property="Margin" Value="0,0,22,0" />
		<Setter Property="FocusVisualStyle" Value="{StaticResource App.FocusVisual}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="TabItem">
					<Grid Background="Transparent">
						<Grid.RowDefinitions>
							<RowDefinition Height="*" />
							<RowDefinition Height="2" />
						</Grid.RowDefinitions>
						<ContentPresenter Grid.Row="0"
										  ContentSource="Header"
										  HorizontalAlignment="Center"
										  VerticalAlignment="Center" />
						<Border x:Name="Indicator"
								Grid.Row="1"
								Background="Transparent"
								CornerRadius="1"
								SnapsToDevicePixels="True" />
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter Property="Foreground" Value="{StaticResource App.Text}" />
						</Trigger>
						<Trigger Property="IsSelected" Value="True">
							<Setter Property="Foreground" Value="{StaticResource App.Signal}" />
							<Setter Property="FontWeight" Value="SemiBold" />
							<Setter TargetName="Indicator" Property="Background" Value="{StaticResource App.Signal}" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- The "paper" editor: white surface, 1px hairline, focus ring in
	     the signal tone. Replaces the old invisible-until-focus box. -->
	<Style x:Key="App.InsetEditor" TargetType="Border">
		<Setter Property="Background" Value="{StaticResource App.Surface}" />
		<Setter Property="BorderBrush" Value="{StaticResource App.BorderEmphasis}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="CornerRadius" Value="8" />
		<Setter Property="SnapsToDevicePixels" Value="True" />
		<Style.Triggers>
			<Trigger Property="IsKeyboardFocusWithin" Value="True">
				<Setter Property="BorderBrush" Value="{StaticResource App.Signal}" />
			</Trigger>
		</Style.Triggers>
	</Style>

	<!-- Sidebar agent row shell: no shadow, hairline bottom between
	     rows when needed. Kept as a Border style so old callers still
	     resolve. -->
	<Style x:Key="App.HairlineRow" TargetType="Border">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderBrush" Value="{StaticResource App.LineSoft}" />
		<Setter Property="BorderThickness" Value="0,0,0,1" />
	</Style>

	<Style x:Key="App.DataGrid" TargetType="DataGrid">
		<Setter Property="Background" Value="{StaticResource App.Surface}" />
		<Setter Property="BorderBrush" Value="{StaticResource App.Line}" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="GridLinesVisibility" Value="Horizontal" />
		<Setter Property="HorizontalGridLinesBrush" Value="{StaticResource App.Line}" />
		<Setter Property="RowBackground" Value="{StaticResource App.Surface}" />
		<Setter Property="AlternatingRowBackground" Value="{StaticResource App.SurfaceAlt}" />
		<Setter Property="RowHeaderWidth" Value="0" />
		<Setter Property="HeadersVisibility" Value="Column" />
		<Setter Property="CanUserAddRows" Value="False" />
		<Setter Property="AutoGenerateColumns" Value="False" />
	</Style>
</ResourceDictionary>
