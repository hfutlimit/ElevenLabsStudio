<UserControl x:Class="ElevenLabsStudio.Views.Agents.UpdateAgentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:domain="clr-namespace:ElevenLabsStudio.Core.Domain;assembly=ElevenLabsStudio.Core">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <materialDesign:ColorZone Grid.Row="0" Mode="PrimaryMid" Padding="8">
            <DockPanel>
                <Button x:Name="Save"
                        DockPanel.Dock="Right"
                        Content="Push"
                        Margin="6,0,0,0" />
                <Button x:Name="Reanalyse"
                        DockPanel.Dock="Right"
                        Content="Re-analyse" />
                <TextBlock Text="{Binding Agent.Name, StringFormat='Editing: {0}'}"
                           VerticalAlignment="Center"
                           FontSize="16"
                           FontWeight="SemiBold" />
            </DockPanel>
        </materialDesign:ColorZone>

        <TextBox Grid.Row="1"
                 x:Name="Prompt"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 materialDesign:HintAssist.Hint="System prompt"
                 Height="220"
                 Margin="0,8,0,0" />

        <TextBox Grid.Row="2"
                 x:Name="FirstMessage"
                 materialDesign:HintAssist.Hint="First message"
                 Margin="0,8,0,0" />

        <TextBox Grid.Row="3"
                 x:Name="VoiceId"
                 materialDesign:HintAssist.Hint="Voice ID"
                 Margin="0,8,0,0" />

        <TextBlock Grid.Row="4"
                   Text="Local suggestions"
                   FontWeight="SemiBold"
                   Margin="0,12,0,4" />

        <ListBox Grid.Row="5"
                 x:Name="Suggestions"
                 MinHeight="120">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Information" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding FieldName}" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Text="{Binding Rationale}" TextWrapping="Wrap" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>