<UserControl x:Class="ElevenLabsStudio.Views.Agents.AgentListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:cal="http://www.caliburnproject.org"
             Background="{StaticResource App.Side}">

    <!-- studio-harmony rebuild. The rail is a warm-tinted panel
         (App.Side), not a card. Each agent row is an icon tile + name/id
         stack with a single green selection dot on the trailing edge.
         The collapse toggle lives in ShellView, so this view only owns
         the + import action. -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Head: eyebrow + count on the left, + import on the right.
             The 44px right margin reserves the corner for the shell's
             collapse toggle so the two icon buttons sit side by side
             instead of stacking into an orphaned column. -->
        <Grid Grid.Row="0" Margin="16,12,44,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Agents"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource App.Text}" />
                <Border Background="#E9ECE5"
                        CornerRadius="4"
                        Padding="6,2"
                        Margin="7,1,0,0"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding Agents.Count, Mode=OneWay, FallbackValue=0}"
                               FontSize="10"
                               Foreground="{StaticResource App.Ink2}" />
                </Border>
            </StackPanel>
            <Button x:Name="ImportAgent"
                    Grid.Column="1"
                    cal:Message.Attach="[Event Click] = [Action ImportAgentAsync()]"
                    Style="{StaticResource App.IconButton}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    ToolTip="Import agent by ID"
                    AutomationProperties.Name="Import Agent">
                <materialDesign:PackIcon Kind="Plus" Width="14" Height="14" />
            </Button>
        </Grid>

        <!-- List. No shadowed card. Selected row = white surface +
             2x20 signal bar on the left. Hover = a single subtle tint. -->
        <ListBox Grid.Row="1"
                 x:Name="AgentsView"
                 ItemsSource="{Binding AgentsView}"
                 SelectedItem="{Binding SelectedAgent, Mode=TwoWay}"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="10,0,10,8"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 HorizontalContentAlignment="Stretch">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,3" />
                    <Setter Property="MinHeight" Value="54" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                    <Setter Property="FocusVisualStyle" Value="{StaticResource App.FocusVisual}" />
                    <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Row"
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        BorderThickness="1"
                                        CornerRadius="7"
                                        Padding="11,10"
                                        SnapsToDevicePixels="True">
                                    <ContentPresenter HorizontalAlignment="Stretch"
                                                      VerticalAlignment="Stretch" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Row" Property="Background" Value="{StaticResource App.SurfaceHover}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Row" Property="Background" Value="{StaticResource App.Surface}" />
                                        <Setter TargetName="Row" Property="BorderBrush" Value="#DEE5D9" />
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource App.Signal}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- Icon tile. -->
                        <Border x:Name="IconTile"
                                Width="32" Height="34"
                                CornerRadius="7"
                                Background="#E8ECE3"
                                VerticalAlignment="Center">
                            <materialDesign:PackIcon x:Name="IconGlyph"
                                                     Kind="RobotOutline"
                                                     Width="17" Height="17"
                                                     Foreground="#7B8B73"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center" />
                        </Border>
                        <!-- Name + id. -->
                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Margin="11,0,8,0">
                            <TextBlock Text="{Binding Name}"
                                       FontSize="12"
                                       FontWeight="Medium"
                                       LineHeight="16"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource App.Text}" />
                            <TextBlock Text="{Binding AgentId}"
                                       FontFamily="{StaticResource App.MonoFont}"
                                       FontSize="9.5"
                                       LineHeight="13"
                                       Margin="0,5,0,0"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource App.Ink3}" />
                        </StackPanel>
                        <!-- Trailing selection dot. -->
                        <Ellipse x:Name="SelectionDot"
                                 Grid.Column="2"
                                 Width="5" Height="5"
                                 Fill="{StaticResource App.Signal}"
                                 VerticalAlignment="Center"
                                 Visibility="Collapsed" />
                    </Grid>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                            <Setter TargetName="IconTile" Property="Background" Value="{StaticResource App.SignalWash}" />
                            <Setter TargetName="IconGlyph" Property="Foreground" Value="{StaticResource App.Signal}" />
                            <Setter TargetName="SelectionDot" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Empty state overlay: wraps within 310 - 32 (outer) - 24
             (icon+gap) = 254 px, which is what WorkspaceLayoutTests
             asserts. -->
        <Border Grid.Row="1"
                Margin="16,8,16,16"
                VerticalAlignment="Top"
                Background="Transparent"
                IsHitTestVisible="False"
                Visibility="{Binding HasNoAgents, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <materialDesign:PackIcon Kind="InformationOutline"
                                         Width="16" Height="16"
                                         Margin="0,0,8,0"
                                         VerticalAlignment="Top"
                                         Foreground="{StaticResource App.Ink3}" />
                <TextBlock Grid.Column="1"
                           Text="No agents yet. Use + above to import one by ID."
                           TextWrapping="Wrap"
                           FontSize="11"
                           LineHeight="15"
                           Foreground="{StaticResource App.Ink2}" />
            </Grid>
        </Border>

        <!-- Foot: connection status. One hairline above. -->
        <Border Grid.Row="2"
                BorderBrush="{StaticResource App.Line}"
                BorderThickness="0,1,0,0"
                Background="{StaticResource App.Side}"
                Padding="16,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="6" Height="6"
                         Fill="{StaticResource App.Success}"
                         VerticalAlignment="Center"
                         Margin="0,0,6,0" />
                <TextBlock Text="Connected"
                           FontSize="11"
                           Foreground="{StaticResource App.Ink2}"
                           VerticalAlignment="Center" />
                <TextBlock Text="·"
                           FontSize="11"
                           Margin="6,0"
                           Foreground="{StaticResource App.Ink3}"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding BusyMessage, FallbackValue='Ready'}"
                           FontSize="11"
                           Foreground="{StaticResource App.Ink3}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="180" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
