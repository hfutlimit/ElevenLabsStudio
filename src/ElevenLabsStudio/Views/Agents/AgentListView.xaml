<UserControl x:Class="ElevenLabsStudio.Views.Agents.AgentListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:cal="http://www.caliburnproject.org">
    <Border Style="{StaticResource App.ElevatedCard}">
        <DockPanel Margin="0">
            <!-- Title row: agents heading on the left, a compact "+" import
                 action on the right so the secondary button stops pushing
                 the list down. -->
            <Grid DockPanel.Dock="Top" Margin="16,14,16,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Agents"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource App.TextSecondary}"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        x:Name="ImportAgent"
                        cal:Message.Attach="[Event Click] = [Action ImportAgentAsync()]"
                        Style="{StaticResource App.IconButton}"
                        Width="28"
                        Height="28"
                        ToolTip="Import agent by ID"
                        AutomationProperties.Name="Import Agent">
                    <materialDesign:PackIcon Kind="Plus" Width="14" Height="14" />
                </Button>
            </Grid>

            <!-- Flat empty state: no card-in-card, muted ink only. -->
            <Border DockPanel.Dock="Bottom"
                    Margin="16,8,16,16"
                    Background="Transparent"
                    Visibility="{Binding HasNoAgents, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <materialDesign:PackIcon Kind="InformationOutline"
                                             Width="16" Height="16"
                                             Margin="0,0,8,0"
                                             VerticalAlignment="Top"
                                             Foreground="{StaticResource App.TextMuted}" />
                    <TextBlock Grid.Column="1"
                               Text="No agents yet. Click Import Agent above to import one by ID."
                               TextWrapping="Wrap"
                               FontSize="11"
                               Foreground="{StaticResource App.TextSecondary}" />
                </Grid>
            </Border>

            <!-- Middle: list -->
            <ListBox x:Name="AgentsView"
                     ItemsSource="{Binding AgentsView}"
                     SelectedItem="{Binding SelectedAgent, Mode=TwoWay}"
                     Background="Transparent"
                     BorderThickness="0"
                     HorizontalContentAlignment="Stretch">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="8,2" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                        <Setter Property="FocusVisualStyle" Value="{StaticResource App.FocusVisual}" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Grid>
                                        <Border x:Name="Row"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="10,8">
                                            <ContentPresenter HorizontalAlignment="Stretch"
                                                              VerticalAlignment="Stretch" />
                                        </Border>
                                        <Border x:Name="SelectionBar"
                                                Width="3"
                                                Height="20"
                                                CornerRadius="2"
                                                Background="{StaticResource App.Accent}"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Opacity="0" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{StaticResource App.SurfaceHover}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{StaticResource App.AccentSoft}" />
                                            <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource App.AccentBorder}" />
                                            <Setter TargetName="SelectionBar" Property="Opacity" Value="1" />
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource App.Accent}" />
                                            <Setter TargetName="Row" Property="BorderThickness" Value="2" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="26" Height="26"
                                    CornerRadius="8"
                                    Background="{StaticResource App.SurfaceAlt}"
                                    BorderBrush="{StaticResource App.Border}"
                                    BorderThickness="1"
                                    VerticalAlignment="Center"
                                    Margin="0,0,10,0">
                                <materialDesign:PackIcon Kind="AccountVoice"
                                                         Width="13" Height="13"
                                                         Foreground="{StaticResource App.Accent}"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}"
                                           FontWeight="SemiBold"
                                           FontSize="13"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource App.Text}" />
                                <TextBlock Text="{Binding CreatedAt, StringFormat='{}{0:MM-dd HH:mm}'}"
                                           FontSize="11"
                                           Margin="0,2,0,0"
                                           Foreground="{StaticResource App.TextMuted}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Border>
</UserControl>
