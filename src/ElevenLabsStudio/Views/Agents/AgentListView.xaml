<UserControl x:Class="ElevenLabsStudio.Views.Agents.AgentListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Border BorderBrush="{StaticResource App.Border}"
            BorderThickness="1"
            Background="{StaticResource App.Surface}"
            CornerRadius="4">
        <DockPanel Margin="0">
            <!-- Top: Pull + filter -->
            <StackPanel DockPanel.Dock="Top" Margin="14,14,14,12">
                <Button x:Name="PullAgentById"
                        Content="📥  拉取 Agent"
                        Margin="0,0,0,10"
                        HorizontalAlignment="Stretch"
                        Height="34"
                        Background="{StaticResource App.Accent}"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="SemiBold" />
                <TextBox x:Name="FilterText"
                         materialDesign:HintAssist.Hint="🔍 过滤 (Name 或 AgentId)"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         FontSize="12" />
            </StackPanel>

            <!-- Bottom: empty hint -->
            <TextBlock DockPanel.Dock="Bottom"
                       Text="未拉取任何 Agent。点击「📥 拉取 Agent」开始。"
                       TextWrapping="Wrap"
                       FontSize="11"
                       Foreground="{StaticResource App.TextMuted}"
                       Margin="14,8,14,14"
                       Visibility="{Binding HasNoAgents, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <!-- Middle: list -->
            <ListBox x:Name="AgentsView"
                     SelectedItem="{Binding SelectedAgent, Mode=TwoWay}"
                     Background="Transparent"
                     BorderThickness="0"
                     HorizontalContentAlignment="Stretch">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesignListBoxItem}">
                        <Setter Property="Padding" Value="10,8" />
                        <Setter Property="Margin" Value="4,2" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       Foreground="{StaticResource App.Text}" />
                            <TextBlock Text="{Binding AgentId}"
                                       FontSize="11"
                                       FontFamily="Consolas, Cascadia Mono, monospace"
                                       Foreground="{StaticResource App.TextMuted}"
                                       Margin="0,2,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <materialDesign:PackIcon Kind="ClockOutline"
                                                         Width="11" Height="11"
                                                         Margin="0,0,4,0"
                                                         VerticalAlignment="Center"
                                                         Foreground="{StaticResource App.TextMuted}" />
                                <TextBlock Text="{Binding UpdatedAt, StringFormat='{}{0:MM-dd HH:mm}'}"
                                           FontSize="11"
                                           Foreground="{StaticResource App.TextSecondary}" />
                                <materialDesign:PackIcon Kind="VolumeHigh"
                                                         Width="11" Height="11"
                                                         Margin="10,0,4,0"
                                                         VerticalAlignment="Center"
                                                         Foreground="{StaticResource App.TextMuted}" />
                                <TextBlock Text="{Binding VoiceId}"
                                           FontSize="11"
                                           FontFamily="Consolas, Cascadia Mono, monospace"
                                           Foreground="{StaticResource App.TextSecondary}" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Border>
</UserControl>