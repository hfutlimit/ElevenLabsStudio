<UserControl x:Class="ElevenLabsStudio.Views.Agents.AgentListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:cal="http://www.caliburnproject.org">
    <Border Style="{StaticResource App.ElevatedCard}">
        <DockPanel Margin="0">
            <StackPanel DockPanel.Dock="Top" Margin="16,16,16,12">
                <DockPanel Margin="0,0,0,14">
                    <Border DockPanel.Dock="Left"
                            Width="34" Height="34"
                            CornerRadius="10"
                            Background="{StaticResource App.AccentSoft}"
                            BorderBrush="{StaticResource App.AccentBorder}"
                            BorderThickness="1"
                            Margin="0,0,10,0">
                        <materialDesign:PackIcon Kind="RobotOutline"
                                                 Width="18" Height="18"
                                                 Foreground="{StaticResource App.Accent}"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Agents"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource App.Text}"
                               VerticalAlignment="Center" />
                </DockPanel>
                <Button x:Name="ImportAgent"
                        cal:Message.Attach="[Event Click] = [Action ImportAgentAsync()]"
                        Style="{StaticResource App.PrimaryButton}"
                        Margin="0,0,0,12"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.Name="Import Agent">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Import"
                                                 Width="16" Height="16"
                                                 Margin="0,0,7,0" />
                        <TextBlock Text="Import Agent" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <Border DockPanel.Dock="Bottom"
                    Style="{StaticResource App.SectionCard}"
                    Margin="16,8,16,16"
                    Padding="12"
                    Visibility="{Binding HasNoAgents, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <materialDesign:PackIcon Kind="InformationOutline"
                                             Width="16" Height="16"
                                             Margin="0,0,8,0"
                                             VerticalAlignment="Top"
                                             Foreground="{StaticResource App.Accent}" />
                    <TextBlock Grid.Column="1"
                               Text="No agents yet. Click Import Agent above to import one by ID."
                               TextWrapping="Wrap"
                               FontSize="11"
                               Foreground="{StaticResource App.TextSecondary}" />
                </Grid>
            </Border>

            <!-- Middle: list -->
            <ListBox x:Name="AgentsView"
                     ItemsSource="{Binding AgentsView}"
                     SelectedItem="{Binding SelectedAgent, Mode=TwoWay}"
                     Background="Transparent"
                     BorderThickness="0"
                     HorizontalContentAlignment="Stretch">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="8,2" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="FocusVisualStyle" Value="{StaticResource App.FocusVisual}" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Grid>
                                        <Border x:Name="Row"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                BorderThickness="1"
                                                CornerRadius="9"
                                                Padding="11,10">
                                            <ContentPresenter />
                                        </Border>
                                        <Border x:Name="SelectionBar"
                                                Width="3"
                                                Height="24"
                                                CornerRadius="2"
                                                Background="{StaticResource App.Accent}"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Opacity="0" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{StaticResource App.SurfaceHover}" />
                                            <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource App.Border}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{StaticResource App.AccentSoft}" />
                                            <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource App.AccentBorder}" />
                                            <Setter TargetName="SelectionBar" Property="Opacity" Value="1" />
                                        </Trigger>
										<Trigger Property="IsKeyboardFocused" Value="True">
											<Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource App.Accent}" />
											<Setter TargetName="Row" Property="BorderThickness" Value="2" />
										</Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="26" Height="26"
                                    CornerRadius="8"
                                    Background="{StaticResource App.Surface}"
                                    BorderBrush="{StaticResource App.Border}"
                                    BorderThickness="1"
                                    VerticalAlignment="Top">
                                <materialDesign:PackIcon Kind="AccountVoice"
                                                         Width="14" Height="14"
                                                         Foreground="{StaticResource App.Accent}"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Name}"
                                           FontWeight="SemiBold"
                                           FontSize="13"
                                           Foreground="{StaticResource App.Text}" />
                            <TextBlock Text="{Binding AgentId}"
                                       FontSize="11"
                                       FontFamily="Consolas, Cascadia Mono, monospace"
                                       Foreground="{StaticResource App.TextMuted}"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,2,0,0" />
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ClockOutline"
                                                         Width="11" Height="11"
                                                         Margin="0,0,4,0"
                                                         VerticalAlignment="Center"
                                                         Foreground="{StaticResource App.TextMuted}" />
                                <TextBlock Text="{Binding CreatedAt, StringFormat='{}{0:MM-dd HH:mm}'}"
                                           FontSize="11"
                                           Foreground="{StaticResource App.TextSecondary}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right">
                                <materialDesign:PackIcon Kind="VolumeHigh"
                                                         Width="11" Height="11"
                                                         Margin="8,0,4,0"
                                                         VerticalAlignment="Center"
                                                         Foreground="{StaticResource App.TextMuted}" />
                                <TextBlock Text="{Binding VoiceId}"
                                           FontSize="11"
                                           FontFamily="Consolas, Cascadia Mono, monospace"
                                           MaxWidth="72"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource App.TextSecondary}" />
                                </StackPanel>
                            </Grid>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Border>
</UserControl>
