<UserControl x:Class="ElevenLabsStudio.Views.Agents.AgentListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:cal="http://www.caliburnproject.org">
    <DockPanel Margin="0,0,12,0">
        <!-- Top: Pull + filter -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <Button x:Name="PullAgentById"
                    Content="📥  拉取 Agent"
                    Margin="0,0,0,8"
                    HorizontalAlignment="Stretch"
                    Style="{StaticResource MaterialDesignRaisedAccentButton}" />
            <TextBox x:Name="FilterText"
                     materialDesign:HintAssist.Hint="🔍 过滤 (Name 或 AgentId)"
                     Style="{StaticResource MaterialDesignFloatingHintTextBox}" />
        </StackPanel>

        <!-- Bottom: empty hint -->
        <TextBlock DockPanel.Dock="Bottom"
                   Text="未拉取任何 Agent。点击「📥 拉取 Agent」开始。"
                   TextWrapping="Wrap"
                   Opacity="0.6"
                   Margin="0,8,0,0"
                   Visibility="{Binding HasNoAgents, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <!-- Middle: list (cal:View.Model lets CM resolve the right-side detail VM) -->
        <ListBox x:Name="AgentsView"
                 SelectedItem="{Binding SelectedAgent, Mode=TwoWay}"
                 HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="8" Margin="0,2">
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding AgentId}"
                                       FontSize="11"
                                       FontFamily="Consolas, Cascadia Mono, monospace"
                                       Opacity="0.65" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <materialDesign:PackIcon Kind="ClockOutline"
                                                         Width="12" Height="12"
                                                         Margin="0,0,4,0"
                                                         VerticalAlignment="Center" />
                                <TextBlock Text="{Binding UpdatedAt, StringFormat='{}{0:MM-dd HH:mm}'}"
                                           FontSize="11"
                                           Opacity="0.7" />
                                <materialDesign:PackIcon Kind="VolumeHigh"
                                                         Width="12" Height="12"
                                                         Margin="10,0,4,0"
                                                         VerticalAlignment="Center" />
                                <TextBlock Text="{Binding VoiceId}"
                                           FontSize="11"
                                           FontFamily="Consolas, Cascadia Mono, monospace"
                                           Opacity="0.65" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>