<UserControl x:Class="ElevenLabsStudio.Views.Agents.ImportAgentDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:cal="http://www.caliburnproject.org"
             Width="480"
             Background="{StaticResource App.Canvas}">
    <Border Style="{StaticResource App.ElevatedCard}"
            Margin="16"
            Padding="22">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Import an agent into the app"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource App.Text}" />
            <TextBlock Text="Enter an ElevenLabs Agent ID to load its full configuration"
                       FontSize="11"
                       Foreground="{StaticResource App.TextSecondary}"
                       Margin="0,3,0,0" />
        </StackPanel>

        <Border Grid.Row="2"
                Style="{StaticResource App.SectionCard}"
                Padding="14"
                Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Agent ID"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource App.TextSecondary}"
                           Margin="1,0,0,7" />
                <TextBox x:Name="AgentId"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         materialDesign:HintAssist.Hint="For example, agent_abc123"
                         materialDesign:TextFieldAssist.LeadingIcon="Identifier"
                         Background="{StaticResource App.Surface}"
                         BorderBrush="{StaticResource App.Border}"
                         FontSize="13"
                         MinHeight="44" />
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="3"
                   x:Name="ErrorText"
                   Text="{Binding Error}"
                   Foreground="{StaticResource App.Danger}"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Margin="2,0,2,8"
                   Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button x:Name="Cancel"
                    cal:Message.Attach="[Event Click] = [Action Cancel()]"
                    Style="{StaticResource App.SecondaryButton}"
                    Content="Cancel"
                    Width="86"
                    Margin="0,0,10,0" />
            <Button x:Name="Confirm"
                    cal:Message.Attach="[Event Click] = [Action Confirm()]"
                    Style="{StaticResource App.PrimaryButton}"
                    Width="110"
                    IsEnabled="{Binding CanConfirm}">
                <TextBlock Text="Import Agent" />
            </Button>
        </StackPanel>
    </Grid>
    </Border>
</UserControl>
