<UserControl x:Class="ElevenLabsStudio.Views.Agents.ImportAgentDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:cal="http://www.caliburnproject.org"
             Width="480"
             Background="{StaticResource App.Canvas}">
    <Border Style="{StaticResource App.ElevatedCard}"
            Margin="16"
            Padding="22">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Grid.RowSpan="2" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="40" Height="40"
                    CornerRadius="12"
                    Background="{StaticResource App.AccentSoft}"
                    BorderBrush="{StaticResource App.AccentBorder}"
                    BorderThickness="1"
                    VerticalAlignment="Top">
                <materialDesign:PackIcon Kind="Import"
                                         Width="20" Height="20"
                                         Foreground="{StaticResource App.Accent}"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Import an agent into the app"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource App.Text}" />
                <TextBlock Text="Enter an ElevenLabs Agent ID to load its full configuration"
                           FontSize="11"
                           Foreground="{StaticResource App.TextSecondary}"
                           Margin="0,3,0,0" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="2"
                Style="{StaticResource App.SectionCard}"
                Padding="14"
                Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Agent ID"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource App.TextSecondary}"
                           Margin="1,0,0,7" />
                <TextBox x:Name="AgentId"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         materialDesign:HintAssist.Hint="For example, agent_abc123"
                         materialDesign:TextFieldAssist.LeadingIcon="Identifier"
                         Background="{StaticResource App.Surface}"
                         BorderBrush="{StaticResource App.BorderStrong}"
                         FontSize="13"
                         MinHeight="44" />
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="3"
                   x:Name="ErrorText"
                   Text="{Binding Error}"
                   Foreground="{StaticResource App.Danger}"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Margin="2,0,2,8"
                   Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button x:Name="Cancel"
                    cal:Message.Attach="[Event Click] = [Action Cancel()]"
                    Style="{StaticResource App.SecondaryButton}"
                    Content="Cancel"
                    Width="86"
                    Margin="0,0,10,0" />
            <Button x:Name="Confirm"
                    cal:Message.Attach="[Event Click] = [Action Confirm()]"
                    Style="{StaticResource App.PrimaryButton}"
                    Width="98"
                    IsEnabled="{Binding CanConfirm}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Import" Width="14" Height="14" Margin="0,0,6,0" />
                    <TextBlock Text="Import Agent" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
    </Border>
</UserControl>
