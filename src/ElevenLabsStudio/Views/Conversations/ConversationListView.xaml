<UserControl x:Class="ElevenLabsStudio.Views.Conversations.ConversationListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <materialDesign:ColorZone Grid.Row="0" Mode="PrimaryMid" Padding="8">
            <DockPanel>
                <Button x:Name="LoadAsync" DockPanel.Dock="Right" Style="{StaticResource MaterialDesignIconButton}" ToolTip="Refresh">
                    <materialDesign:PackIcon Kind="Refresh" />
                </Button>
                <TextBlock Text="Conversations"
                           VerticalAlignment="Center"
                           FontSize="16"
                           FontWeight="SemiBold" />
            </DockPanel>
        </materialDesign:ColorZone>

        <ListBox Grid.Row="1" x:Name="Conversations" SelectedItem="{Binding SelectedConversation, Mode=TwoWay}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding StartedAt, StringFormat='yyyy-MM-dd HH:mm'}" Width="140" />
                        <TextBlock Text="{Binding Status}" Width="80" />
                        <TextBlock Text="{Binding AgentId}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <ScrollViewer Grid.Row="2" Margin="0,8,0,0">
            <ItemsControl x:Name="Turns">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,4" Padding="8" CornerRadius="4" Background="{DynamicResource MaterialDesign.Brush.Card.Background}">
                            <StackPanel>
                                <TextBlock Text="{Binding Speaker}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>