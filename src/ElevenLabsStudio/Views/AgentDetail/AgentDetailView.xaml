<UserControl x:Class="ElevenLabsStudio.Views.AgentDetail.AgentDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:cal="http://www.caliburnproject.org"
             Background="{StaticResource App.Canvas}">

    <!-- Route B rebuild (docs/prototypes/2026-09-24-redesign-review.md).
         The pane is one flat region: a 3px sync rail on the left, a
         header, an underline tab strip, a scrollable MaxWidth=780
         content column, and a sticky action footer. No ElevatedCard,
         no SectionCard, no shadow, no chip tabs. The rail and header
         pip reflect AgentDetailViewModel.IsDirty so the user can see
         divergence without pressing Push first. -->

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sync rail. Grey = matches server, Signal = diverged. -->
        <Border x:Name="SyncRail" Grid.Column="0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource App.Line}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDirty}" Value="True">
                            <Setter Property="Background" Value="{StaticResource App.Warning}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 1. Header: name (20px 650) + id (mono ink3), meta row
                     with sync pip + server stamp + voice id. Icon
                     actions live on the far right, not the footer. -->
            <Grid Grid.Row="0" Margin="38,18,38,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="AGENT WORKSPACE"
                               Style="{StaticResource App.Eyebrow}"
                               FontSize="8.5"
                               Margin="0,0,0,9" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Agent.Name}"
                                   FontSize="26"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource App.Text}" />
                        <TextBlock Text="{Binding Agent.AgentId}"
                                   FontFamily="{StaticResource App.MonoFont}"
                                   FontSize="10"
                                   Margin="13,0,0,4"
                                   VerticalAlignment="Bottom"
                                   Foreground="{StaticResource App.Ink3}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Top"
                            Margin="0,4,0,0">
                    <Button x:Name="DryRun"
                            Style="{StaticResource App.SecondaryButton}"
                            Margin="0,0,8,0"
                            ToolTip="Dry run — re-run local suggestions"
                            AutomationProperties.Name="Dry run">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Check" Width="14" Height="14" Margin="0,0,7,0" />
                            <TextBlock Text="Dry run" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ReloadAsync"
                            Style="{StaticResource App.SecondaryButton}"
                            ToolTip="Reload agent from server"
                            AutomationProperties.Name="Reload">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Refresh" Width="14" Height="14" Margin="0,0,7,0" />
                            <TextBlock Text="Reload" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 2. Underline tab strip. Custom TabControl template:
                     header row owns the shared hairline, content row
                     gets its own padding. This is how the prototype's
                     ".nav + .content" pattern maps to WPF. -->
            <TabControl Grid.Row="1"
                        Style="{x:Null}"
                        SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        ItemContainerStyle="{StaticResource App.TabItem}">
                <TabControl.ItemsPanel>
                    <!-- Force a content-sized horizontal strip. The
                         MaterialDesign3 implicit TabControl style ships
                         a custom ItemsPanel that squeezes each tab below
                         its header width and clips the text ("System
                         Prompt" -> "System Pro"). Overriding the style
                         with x:Null plus an explicit StackPanel makes
                         the strip deterministic. -->
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </TabControl.ItemsPanel>
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0"
                                    BorderBrush="{StaticResource App.Line}"
                                    BorderThickness="0,0,0,1"
                                    Padding="38,0,38,0">
                                <!-- Host the tabs in a horizontal StackPanel,
                                     not a TabPanel. TabPanel squeezes each
                                     header below its measured width (the
                                     MaterialDesign3 "System Pro" truncation),
                                     so the custom template's items host has
                                     to be a StackPanel for the labels to size
                                     to content. -->
                                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Disabled">
                                    <StackPanel Orientation="Horizontal"
                                                IsItemsHost="True"
                                                Background="Transparent"
                                                Margin="0" />
                                </ScrollViewer>
                            </Border>
                            <!-- The selected tab renders into ONE fixed,
                                 content-independent region: the row above is
                                 a star row, so the box gets whatever the pane
                                 has left after the strip and the footer, and
                                 never a pixel more or less because the
                                 selected tab happens to want a taller view.
                                 ClipToBounds is the load-bearing part — an
                                 unbounded view (the workflow canvas sizes
                                 itself from its nodes, MaterialDesign editor
                                 helper text hangs below the editor box)
                                 would otherwise paint straight over the
                                 sticky footer, which reads to the user as
                                 "the tab changed height". -->
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              Grid.Row="1" ContentSource="SelectedContent"
                                              VerticalAlignment="Stretch"
                                              ClipToBounds="True"
                                              Margin="38,12,38,12" />
                        </Grid>
                    </ControlTemplate>
                </TabControl.Template>
                <TabItem Header="New Conversation">
                    <ContentControl cal:View.Model="{Binding LiveConversationVm}"
                                    HorizontalAlignment="Stretch"
                                    VerticalContentAlignment="Stretch" />
                </TabItem>
                <TabItem Header="System Prompt">
                    <ContentControl cal:View.Model="{Binding SystemPromptVm}"
                                    MaxWidth="980"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch" />
                </TabItem>
                <TabItem Header="First Message">
                    <ContentControl cal:View.Model="{Binding FirstMessageVm}"
                                    MaxWidth="980"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch" />
                </TabItem>
                <TabItem Header="Workflow">
                    <ContentControl cal:View.Model="{Binding WorkflowVm}"
                                    HorizontalAlignment="Stretch"
                                    VerticalContentAlignment="Stretch" />
                </TabItem>
                <TabItem Header="Variables">
                    <ContentControl cal:View.Model="{Binding VariablesVm}"
                                    HorizontalAlignment="Stretch"
                                    VerticalContentAlignment="Stretch" />
                </TabItem>
                <TabItem Header="Conversations">
                    <ContentControl cal:View.Model="{Binding ConversationsVm}"
                                    HorizontalAlignment="Stretch"
                                    VerticalContentAlignment="Stretch" />
                </TabItem>
            </TabControl>

            <!-- 3. Sticky action footer. Push lives here (was in the
                     header, which made the header feel like a card
                     inside a card). -->
            <Border Grid.Row="2"
                    BorderBrush="{StaticResource App.Line}"
                    BorderThickness="0,1,0,0"
                    Background="{StaticResource App.Canvas}"
                    Height="56"
                    Padding="38,0">
                <!-- Agent actions. Hidden on New Conversation, where there is
                     no agent draft to save or push — the live session is
                     driven by voice only. The footer height is fixed, so
                     this never resizes the pane. -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Margin="0,0,9,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource App.Ink3}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDirty}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource App.Warning}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock VerticalAlignment="Center"
                                       FontSize="11.5"
                                       Foreground="{StaticResource App.Ink2}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Matches the server snapshot" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDirty}" Value="True">
                                                <Setter Property="Text" Value="Draft edits — not on the server yet" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="SaveDraft"
                                    Style="{StaticResource App.SecondaryButton}"
                                    Margin="0,0,10,0"
                                    Content="Save draft"
                                    ToolTip="Persist current edits locally without pushing"
                                    AutomationProperties.Name="Save draft" />
                            <Button x:Name="Push"
                                    Style="{StaticResource App.PrimaryButton}"
                                    AutomationProperties.Name="Push changes">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="CloudUploadOutline"
                                                             Width="14" Height="14"
                                                             Margin="0,0,6,0" />
                                    <TextBlock Text="Push to server" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
