<UserControl x:Class="ElevenLabsStudio.Views.AgentDetail.AgentDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:cal="http://www.caliburnproject.org">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{Binding Agent.Name}"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource App.Text}" />
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <materialDesign:PackIcon Kind="Identifier"
                                         Width="14" Height="14"
                                         Margin="0,0,6,0"
                                         VerticalAlignment="Center"
                                         Foreground="{StaticResource App.TextMuted}" />
                <TextBlock Text="{Binding Agent.AgentId}"
                           FontSize="12"
                           FontFamily="Consolas, Cascadia Mono, monospace"
                           Foreground="{StaticResource App.TextSecondary}" />
            </StackPanel>
        </StackPanel>

        <!-- Toolbar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <Button x:Name="Push"
                    Content="📤 推送"
                    Height="32"
                    Padding="14,0"
                    Margin="0,0,8,0"
                    Background="{StaticResource App.Accent}"
                    Foreground="White"
                    BorderThickness="0"
                    FontWeight="SemiBold" />
            <Button x:Name="ReloadAsync"
                    Content="🔄 刷新"
                    Height="32"
                    Padding="14,0"
                    Margin="0,0,8,0"
                    Background="{StaticResource App.Surface}"
                    Foreground="{StaticResource App.Text}"
                    BorderBrush="{StaticResource App.BorderStrong}" />
            <Button x:Name="DryRun"
                    Content="🧪 试运行"
                    Height="32"
                    Padding="14,0"
                    Background="Transparent"
                    Foreground="{StaticResource App.TextSecondary}"
                    BorderThickness="0" />
            <materialDesign:PackIcon Kind="ClockOutline"
                                     Width="14" Height="14"
                                     Margin="16,0,6,0"
                                     VerticalAlignment="Center"
                                     Foreground="{StaticResource App.TextMuted}" />
            <TextBlock Text="{Binding Agent.UpdatedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"
                       VerticalAlignment="Center"
                       FontSize="11"
                       Foreground="{StaticResource App.TextSecondary}" />
        </StackPanel>

        <!-- Status hint for workflow dirty state -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,0,12">
            <TextBlock Text="改完后记得点「推送」同步"
                       FontSize="10"
                       Foreground="{StaticResource App.TextMuted}"
                       VerticalAlignment="Center" />
        </StackPanel>

        <!-- Tabs -->
        <TabControl Grid.Row="2"
                    SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
                    Background="Transparent"
                    BorderThickness="0">
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="TextBox" Margin="0,0,6,0" />
                        <TextBlock Text="System Prompt" />
                    </StackPanel>
                </TabItem.Header>
                <ContentControl cal:View.Model="{Binding SystemPromptVm}" />
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CommentTextOutline" Margin="0,0,6,0" />
                        <TextBlock Text="First Msg" />
                    </StackPanel>
                </TabItem.Header>
                <ContentControl cal:View.Model="{Binding FirstMessageVm}" />
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="GraphOutline" Margin="0,0,6,0" />
                        <TextBlock Text="Workflow" />
                    </StackPanel>
                </TabItem.Header>
                <ContentControl cal:View.Model="{Binding WorkflowVm}" />
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="VariableBox" Margin="0,0,6,0" />
                        <TextBlock Text="Variables" />
                    </StackPanel>
                </TabItem.Header>
                <ContentControl cal:View.Model="{Binding VariablesVm}" />
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ForumOutline" Margin="0,0,6,0" />
                        <TextBlock Text="Conversations" />
                    </StackPanel>
                </TabItem.Header>
                <ContentControl cal:View.Model="{Binding ConversationsVm}" />
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>