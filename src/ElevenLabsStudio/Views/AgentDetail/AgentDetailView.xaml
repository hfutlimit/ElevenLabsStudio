<UserControl x:Class="ElevenLabsStudio.Views.AgentDetail.AgentDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:cal="http://www.caliburnproject.org">
    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource App.SectionCard}"
                Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="28" Height="28"
                            CornerRadius="8"
                            Background="{StaticResource App.AccentSoft}"
                            BorderBrush="{StaticResource App.AccentBorder}"
                            BorderThickness="1"
                            VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="AccountVoice"
                                                 Width="15" Height="15"
                                                 Foreground="{StaticResource App.Accent}"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                        <TextBlock Text="{Binding Agent.Name}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource App.Text}" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="{Binding Agent.AgentId}"
                                       FontSize="11"
                                       FontFamily="Consolas, Cascadia Mono, monospace"
                                       Foreground="{StaticResource App.TextSecondary}" />
                            <Border Style="{StaticResource App.Badge}"
                                    Margin="12,0,0,0"
                                    Padding="7,2">
                                <TextBlock Text="{Binding Agent.UpdatedAt, StringFormat='{}{0:MM-dd HH:mm}'}"
                                           FontSize="11"
                                           Foreground="{StaticResource App.TextSecondary}" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button x:Name="DryRun"
                            Style="{StaticResource App.GhostButton}"
                            Margin="0,0,4,0"
                            Width="32" Height="32"
                            ToolTip="Re-run local suggestions"
                            AutomationProperties.Name="Dry run">
                        <materialDesign:PackIcon Kind="FlaskOutline" Width="16" Height="16" />
                    </Button>
                    <Button x:Name="ReloadAsync"
                            Style="{StaticResource App.GhostButton}"
                            Margin="0,0,8,0"
                            Width="32" Height="32"
                            ToolTip="Refresh"
                            AutomationProperties.Name="Reload">
                        <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" />
                    </Button>
                    <Button x:Name="Push"
                            Style="{StaticResource App.PrimaryButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CloudUploadOutline" Width="15" Height="15" Margin="0,0,6,0" />
                            <TextBlock Text="Push changes" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tabs -->
        <TabControl Grid.Row="1"
                    SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
                    Background="Transparent"
                    BorderThickness="0"
                    Margin="0,12,0,0"
                    ItemContainerStyle="{StaticResource App.TabItem}">
            <TabItem Header="System Prompt">
                <ContentControl cal:View.Model="{Binding SystemPromptVm}" />
            </TabItem>
            <TabItem Header="First Message">
                <ContentControl cal:View.Model="{Binding FirstMessageVm}" />
            </TabItem>
            <TabItem Header="Workflow">
                <ContentControl cal:View.Model="{Binding WorkflowVm}" />
            </TabItem>
            <TabItem Header="Variables">
                <ContentControl cal:View.Model="{Binding VariablesVm}" />
            </TabItem>
            <TabItem Header="Conversations">
                <ContentControl cal:View.Model="{Binding ConversationsVm}" />
            </TabItem>
            <TabItem Header="Live conversation">
                <ContentControl cal:View.Model="{Binding LiveConversationVm}" />
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
