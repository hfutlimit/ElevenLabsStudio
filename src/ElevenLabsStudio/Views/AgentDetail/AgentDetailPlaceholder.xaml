<UserControl x:Class="ElevenLabsStudio.Views.AgentDetail.AgentDetailPlaceholder"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid Margin="32" VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel MaxWidth="380" HorizontalAlignment="Center">
            <Border Width="76" Height="76"
                    CornerRadius="22"
                    Background="{StaticResource App.AccentSoft}"
                    BorderBrush="{StaticResource App.AccentBorder}"
                    BorderThickness="1"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,18">
                <materialDesign:PackIcon Kind="RobotOutline"
                                         Width="36" Height="36"
                                         Foreground="{StaticResource App.Accent}"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="选择 Agent 开始"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource App.Text}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,6" />
            <TextBlock TextWrapping="Wrap"
                       TextAlignment="Center"
                       Foreground="{StaticResource App.TextSecondary}"
                       FontSize="12"
                       LineHeight="20"
                       Margin="0,0,0,16">
                <Run Text="从左侧选择一个 Agent 查看完整配置，" />
                <LineBreak />
                <Run Text="或拉取新的 ElevenLabs Agent 到本地。" />
            </TextBlock>
        </StackPanel>
    </Grid>
</UserControl>
