<UserControl x:Class="ElevenLabsStudio.Views.AgentDetail.AgentDetailPlaceholder"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{StaticResource App.Canvas}">

    <!-- Same left-edge structure as AgentDetailView: a 3px rail in the
         idle (Line) tone so the empty pane still reads as "the detail
         column", not a floating card in a void. Content is a compact,
         centered message using the new ink scale. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{StaticResource App.Line}" />
        <StackPanel Grid.Column="1"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    MaxWidth="340"
                    Margin="0,0,0,40">
            <Border Width="44" Height="44"
                    CornerRadius="10"
                    Background="{StaticResource App.SignalWash}"
                    BorderBrush="{StaticResource App.Line}"
                    BorderThickness="1"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,14">
                <materialDesign:PackIcon Kind="RobotOutline"
                                         Width="22" Height="22"
                                         Foreground="{StaticResource App.Signal}"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="No agent selected"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource App.Text}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,5" />
            <TextBlock TextWrapping="Wrap"
                       TextAlignment="Center"
                       FontSize="12"
                       LineHeight="18"
                       Foreground="{StaticResource App.Ink2}"
                       HorizontalAlignment="Center">
                <Run Text="Pick an agent on the left, or import one by ID to start editing." />
            </TextBlock>
        </StackPanel>
    </Grid>
</UserControl>
