<UserControl x:Class="ElevenLabsStudio.Views.AgentDetail.ConversationsTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid x:Name="ConversationSplitLayout" Margin="0,12,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" MinWidth="240" MaxWidth="440" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" MinWidth="300" />
        </Grid.ColumnDefinitions>

        <Border x:Name="ConversationListPanel"
                Grid.Column="0"
                Background="{StaticResource App.Tint}"
                BorderBrush="{StaticResource App.Line}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        BorderBrush="{StaticResource App.Border}"
                        BorderThickness="0,0,0,1"
                        Padding="14,10">
                    <DockPanel>
                        <Button x:Name="ReloadAsync"
                                DockPanel.Dock="Right"
                                Style="{StaticResource App.IconButton}"
                                ToolTip="Refresh conversations"
                                Width="30" Height="30"
                                Foreground="{StaticResource App.TextSecondary}">
                            <materialDesign:PackIcon Kind="Refresh" Width="14" Height="14" />
                        </Button>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- The tab header already says "Conversations".
                                 Only the range badge stays, because it
                                 tells the user something the tab name
                                 does not. -->
                            <Border Style="{StaticResource App.Badge}" Padding="7,2">
                                <TextBlock Text="Last 7 days"
                                           FontSize="11"
                                           Foreground="{StaticResource App.TextSecondary}" />
                            </Border>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Grid Grid.Row="1">
                    <ListBox x:Name="Conversations"
                             ItemsSource="{Binding Conversations}"
                             SelectedItem="{Binding SelectedConversation, Mode=TwoWay}"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="12,9" />
                                <Setter Property="Margin" Value="6,3" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="FocusVisualStyle" Value="{StaticResource App.FocusVisual}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Row"
                                                    Background="Transparent"
                                                    BorderBrush="Transparent"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Row" Property="Background" Value="{StaticResource App.SurfaceHover}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Row" Property="Background" Value="{StaticResource App.Surface}" />
                                                    <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource App.Line}" />
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource App.Accent}" />
                                                    <Setter TargetName="Row" Property="BorderThickness" Value="2" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <DockPanel Grid.Row="0">
                                        <Border DockPanel.Dock="Right"
                                                Style="{StaticResource App.Badge}"
                                                Padding="7,2">
                                            <TextBlock Text="{Binding Status}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource App.TextSecondary}" />
                                        </Border>
                                        <TextBlock Text="{Binding StartedAt, StringFormat='{}{0:MM-dd HH:mm}'}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource App.Text}" />
                                    </DockPanel>
                                    <TextBlock Grid.Row="1"
                                               Text="{Binding ConversationId}"
                                               Margin="0,6,0,0"
                                               FontFamily="Consolas, Cascadia Mono, monospace"
                                               FontSize="11"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource App.TextMuted}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Grid x:Name="ConversationListLoadingIndicator"
                          Panel.ZIndex="3"
                          Background="{StaticResource App.Surface}"
                          Visibility="{Binding IsConversationListLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ProgressBar Width="120" Height="4" IsIndeterminate="True" />
                            <TextBlock Text="Loading conversations…"
                                       Margin="0,12,0,0"
                                       FontSize="11"
                                       Foreground="{StaticResource App.TextSecondary}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <GridSplitter x:Name="ConversationSplitter"
                      Grid.Column="1"
                      Width="6"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Stretch"
                      ResizeDirection="Columns"
                      ResizeBehavior="PreviousAndNext"
                      Background="{StaticResource App.Border}"
                      ShowsPreview="True" />

        <Border x:Name="TranscriptPanel"
                Grid.Column="2"
                Background="{StaticResource App.Surface}"
                BorderBrush="{StaticResource App.Line}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        BorderBrush="{StaticResource App.Border}"
                        BorderThickness="0,0,0,1"
                        Padding="14,10">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right"
                                   Text="{Binding SelectedConversation.ConversationId}"
                                   MaxWidth="320"
                                   TextTrimming="CharacterEllipsis"
                                   FontFamily="Consolas, Cascadia Mono, monospace"
                                   FontSize="11"
                                   Foreground="{StaticResource App.TextMuted}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="Transcript"
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   Foreground="{StaticResource App.Text}" />
                    </DockPanel>
                </Border>

                <Grid Grid.Row="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="Turns" Margin="10">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,18">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right"
                                                           Text="{Binding At, StringFormat='{}{0:HH:mm:ss}'}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource App.TextMuted}" />
                                                <TextBlock Text="{Binding Speaker}"
                                                           FontWeight="SemiBold"
                                                           FontSize="11"
                                                           Foreground="{StaticResource App.Text}" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding Text}"
                                                       TextWrapping="Wrap"
                                                           FontSize="12.5"
                                                           LineHeight="20"
                                                       Foreground="{StaticResource App.Text}"
                                                           Margin="0,3,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Grid x:Name="TranscriptLoadingIndicator"
                          Panel.ZIndex="3"
                          Background="{StaticResource App.Surface}"
                          Visibility="{Binding IsTranscriptLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ProgressBar Width="120" Height="4" IsIndeterminate="True" />
                            <TextBlock Text="Loading transcript…"
                                       Margin="0,12,0,0"
                                       FontSize="11"
                                       Foreground="{StaticResource App.TextSecondary}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <!-- A failed request used to leave a blank pane that
                         looked exactly like a conversation with no
                         turns, so the user could not tell "no history"
                         from "the network died". State it, and offer the
                         one retry that usually clears it. -->
                    <Grid Panel.ZIndex="3"
                          Background="{StaticResource App.Surface}"
                          Visibility="{Binding HasTranscriptError, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    MaxWidth="380">
                            <materialDesign:PackIcon Kind="AlertCircleOutline"
                                                     Width="20" Height="20"
                                                     HorizontalAlignment="Center"
                                                     Foreground="{StaticResource App.Danger}" />
                            <TextBlock Text="Could not load the transcript"
                                       Margin="0,10,0,0"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Foreground="{StaticResource App.Text}" />
                            <TextBlock Text="{Binding TranscriptError}"
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       FontSize="11"
                                       Foreground="{StaticResource App.TextMuted}" />
                            <Button x:Name="RetryTranscriptAsync"
                                    Content="Retry"
                                    Style="{StaticResource App.SecondaryButton}"
                                    HorizontalAlignment="Center"
                                    Margin="0,14,0,0"
                                    AutomationProperties.Name="Retry loading transcript" />
                        </StackPanel>
                    </Grid>

                    <!-- Genuinely empty: the request succeeded and there
                         was nothing recorded. -->
                    <Grid Panel.ZIndex="3"
                          Background="{StaticResource App.Surface}"
                          Visibility="{Binding HasNoTranscript, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="MessageTextOutline"
                                                     Width="18" Height="18"
                                                     HorizontalAlignment="Center"
                                                     Foreground="{StaticResource App.TextMuted}" />
                            <TextBlock Text="No transcript recorded"
                                       Margin="0,8,0,0"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Foreground="{StaticResource App.Text}" />
                            <TextBlock Text="This conversation finished without any turns."
                                       Margin="0,4,0,0"
                                       TextAlignment="Center"
                                       FontSize="11"
                                       Foreground="{StaticResource App.TextMuted}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
