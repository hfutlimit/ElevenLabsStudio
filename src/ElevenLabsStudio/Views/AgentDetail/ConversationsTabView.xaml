<UserControl x:Class="ElevenLabsStudio.Views.AgentDetail.ConversationsTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid Margin="0,14,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="0.9*" />
            <RowDefinition Height="1.1*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource App.SectionCard}" Padding="0" Margin="0,0,0,10">
            <DockPanel>
                <Border DockPanel.Dock="Top"
                        Background="Transparent"
                        BorderBrush="{StaticResource App.Border}"
                        BorderThickness="0,0,0,1"
                        Padding="14,10">
                    <DockPanel>
                        <Button x:Name="ReloadAsync"
                                DockPanel.Dock="Right"
                                Style="{StaticResource App.IconButton}"
                                ToolTip="Refresh conversations"
                                Width="30" Height="30"
                                Foreground="{StaticResource App.TextSecondary}">
                            <materialDesign:PackIcon Kind="Refresh" Width="14" Height="14" />
                        </Button>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="History"
                                                     Width="15" Height="15"
                                                     Margin="0,0,7,0"
                                                     Foreground="{StaticResource App.Accent}" />
                            <TextBlock Text="Conversations · Last 7 days"
                                       FontWeight="SemiBold"
                                       FontSize="11"
                                       Foreground="{StaticResource App.TextSecondary}" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <ListBox x:Name="Conversations"
                         SelectedItem="{Binding SelectedConversation, Mode=TwoWay}"
                         BorderThickness="0"
                         Background="Transparent">
                <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="12,8" />
                            <Setter Property="Margin" Value="6,2" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="FocusVisualStyle" Value="{StaticResource App.FocusVisual}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Row"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                BorderThickness="1"
                                                CornerRadius="7"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="{StaticResource App.SurfaceHover}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="{StaticResource App.AccentSoft}" />
                                                <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource App.AccentBorder}" />
                                            </Trigger>
											<Trigger Property="IsKeyboardFocused" Value="True">
												<Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource App.Accent}" />
												<Setter TargetName="Row" Property="BorderThickness" Value="2" />
											</Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding StartedAt, StringFormat='{}{0:MM-dd HH:mm}'}"
                                           FontSize="12"
                                           Foreground="{StaticResource App.Text}" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Status}"
                                           FontSize="12"
                                           Foreground="{StaticResource App.TextSecondary}" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding ConversationId}"
                                           FontFamily="Consolas, Cascadia Mono, monospace"
                                           FontSize="11"
                                           Foreground="{StaticResource App.TextMuted}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource App.SectionCard}" Padding="0">
            <DockPanel>
                <Border DockPanel.Dock="Top"
                        Background="Transparent"
                        BorderBrush="{StaticResource App.Border}"
                        BorderThickness="0,0,0,1"
                        Padding="14,10">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="TextBoxMultipleOutline"
                                                 Width="15" Height="15"
                                                 Margin="0,0,7,0"
                                                 Foreground="{StaticResource App.Accent}" />
                        <TextBlock Text="Transcript"
                                   FontWeight="SemiBold"
                                   FontSize="11"
                                   Foreground="{StaticResource App.TextSecondary}" />
                    </StackPanel>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="Turns" Margin="10">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource App.Surface}"
                                        BorderBrush="{StaticResource App.BorderStrong}"
                                        BorderThickness="1"
                                        Margin="0,4,0,4"
                                        Padding="12,10"
                                        CornerRadius="8">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right"
                                                       Text="{Binding At, StringFormat='{}{0:HH:mm:ss}'}"
                                                       FontSize="10"
                                                       Foreground="{StaticResource App.TextMuted}" />
                                            <TextBlock Text="{Binding Speaker}"
                                                       FontWeight="SemiBold"
                                                       FontSize="12"
                                                       Foreground="{StaticResource App.Accent}" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding Text}"
                                                   TextWrapping="Wrap"
                                                   FontSize="12"
                                                   Foreground="{StaticResource App.Text}"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
