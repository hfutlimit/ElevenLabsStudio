<UserControl x:Class="ElevenLabsStudio.Views.AgentDetail.ConversationsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid Margin="0,12,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <materialDesign:Card Grid.Row="0" Padding="0" Margin="0,0,0,8">
            <DockPanel>
                <materialDesign:ColorZone Mode="PrimaryMid" Padding="12,6" DockPanel.Dock="Top">
                    <DockPanel>
                        <Button x:Name="ReloadAsync"
                                DockPanel.Dock="Right"
                                Style="{StaticResource MaterialDesignIconButton}"
                                ToolTip="Refresh">
                            <materialDesign:PackIcon Kind="Refresh" />
                        </Button>
                        <TextBlock Text="Sessions (last 7 days)" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                </materialDesign:ColorZone>
                <ListBox x:Name="Conversations" SelectedItem="{Binding SelectedConversation, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding StartedAt, StringFormat='{}{0:MM-dd HH:mm}'}" />
                                <TextBlock Grid.Column="1" Text="{Binding Status}" Opacity="0.8" />
                                <TextBlock Grid.Column="2" Text="{Binding ConversationId}" FontFamily="Consolas" FontSize="11" Opacity="0.7" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </materialDesign:Card>

        <materialDesign:Card Grid.Row="1" Padding="0">
            <DockPanel>
                <materialDesign:ColorZone Mode="PrimaryMid" Padding="12,6" DockPanel.Dock="Top">
                    <TextBlock Text="Transcript" FontWeight="SemiBold" />
                </materialDesign:ColorZone>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="Turns" Margin="8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,4"
                                        Padding="10"
                                        CornerRadius="4"
                                        Background="{DynamicResource MaterialDesign.Brush.Card.Background}">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right"
                                                       Text="{Binding At, StringFormat='{}{0:HH:mm:ss}'}"
                                                       FontSize="11"
                                                       Opacity="0.6" />
                                            <TextBlock Text="{Binding Speaker}" FontWeight="SemiBold" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </materialDesign:Card>
    </Grid>
</UserControl>