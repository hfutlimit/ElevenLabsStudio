<UserControl x:Class="ElevenLabsStudio.Views.AgentDetail.ConversationsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid Margin="0,8,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource App.SoftCard}" Padding="0" Margin="0,0,0,8">
            <DockPanel>
                <Border DockPanel.Dock="Top"
                        Background="{StaticResource App.Surface}"
                        BorderBrush="{StaticResource App.Border}"
                        BorderThickness="0,0,0,1"
                        Padding="14,8">
                    <DockPanel>
                        <Button x:Name="ReloadAsync"
                                DockPanel.Dock="Right"
                                Style="{StaticResource MaterialDesignIconButton}"
                                ToolTip="Refresh"
                                Width="28" Height="28"
                                Foreground="{StaticResource App.TextSecondary}">
                            <materialDesign:PackIcon Kind="Refresh" Width="14" Height="14" />
                        </Button>
                        <TextBlock Text="会话记录（近 7 天）"
                                   FontWeight="SemiBold"
                                   FontSize="11"
                                   Foreground="{StaticResource App.TextSecondary}"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                </Border>
                <ListBox x:Name="Conversations"
                         SelectedItem="{Binding SelectedConversation, Mode=TwoWay}"
                         BorderThickness="0"
                         Background="Transparent">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesignListBoxItem}">
                            <Setter Property="Padding" Value="10,6" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding StartedAt, StringFormat='{}{0:MM-dd HH:mm}'}"
                                           FontSize="12"
                                           Foreground="{StaticResource App.Text}" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Status}"
                                           FontSize="12"
                                           Foreground="{StaticResource App.TextSecondary}" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding ConversationId}"
                                           FontFamily="Consolas, Cascadia Mono, monospace"
                                           FontSize="11"
                                           Foreground="{StaticResource App.TextMuted}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource App.SoftCard}" Padding="0">
            <DockPanel>
                <Border DockPanel.Dock="Top"
                        Background="{StaticResource App.Surface}"
                        BorderBrush="{StaticResource App.Border}"
                        BorderThickness="0,0,0,1"
                        Padding="14,8">
                    <TextBlock Text="对话转写"
                               FontWeight="SemiBold"
                               FontSize="11"
                               Foreground="{StaticResource App.TextSecondary}" />
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="Turns" Margin="10">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource App.Surface}"
                                        BorderBrush="{StaticResource App.Border}"
                                        BorderThickness="1"
                                        Margin="0,4,0,4"
                                        Padding="10"
                                        CornerRadius="4">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right"
                                                       Text="{Binding At, StringFormat='{}{0:HH:mm:ss}'}"
                                                       FontSize="10"
                                                       Foreground="{StaticResource App.TextMuted}" />
                                            <TextBlock Text="{Binding Speaker}"
                                                       FontWeight="SemiBold"
                                                       FontSize="12"
                                                       Foreground="{StaticResource App.Accent}" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding Text}"
                                                   TextWrapping="Wrap"
                                                   FontSize="12"
                                                   Foreground="{StaticResource App.Text}"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>