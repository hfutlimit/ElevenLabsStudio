<UserControl x:Class="ElevenLabsStudio.Views.AgentDetail.FirstMessageTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:cal="http://www.caliburnproject.org">

    <!-- Same shape as SystemPromptTabView: label + counter on one row,
         bordered paper editor, collapsible suggestions section below.
         Before this rebuild the view showed only a "Local suggestions"
         header + count and never actually rendered the collection;
         review §3 + §11 close that gap here too. -->

    <!-- The parent owns the measure cap; the field fills that column
         even when the greeting is short or empty. -->
    <Grid HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="120" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Label + counter + Reset (only while the field diverges
             from the server snapshot), mirroring SystemPromptTabView.
             The 12px bottom margin is the header-to-editor transition. -->
        <Grid Grid.Row="0" Margin="2,0,2,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="First message"
                       FontSize="12.5"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource App.Text}"
                       VerticalAlignment="Center" />
            <TextBlock x:Name="FirstMessageLength"
                       Grid.Column="1"
                       Text="0 chars"
                       FontFamily="Consolas, Cascadia Mono, monospace"
                       FontSize="11"
                       Foreground="{StaticResource App.Ink3}"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0" />
            <Button Grid.Column="2"
                    Content="Reset"
                    Style="{StaticResource App.GhostButton}"
                    FontSize="11.5"
                    Height="24"
                    Padding="10,0"
                    VerticalAlignment="Center"
                    cal:Message.Attach="[Event Click] = [Action ResetToServer()]"
                    Visibility="{Binding HasLocalEdits, Converter={StaticResource BooleanToVisibilityConverter}}"
                    ToolTip="Discard local edits and restore the server value"
                    AutomationProperties.Name="Reset first message" />
        </Grid>

        <Border Grid.Row="1"
                Style="{StaticResource App.InsetEditor}">
            <TextBox x:Name="FirstMessage"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     VerticalContentAlignment="Top"
                     FontSize="14"
                     TextBlock.LineHeight="24"
                     TextBlock.LineStackingStrategy="BlockLineHeight"
                     materialDesign:HintAssist.Hint="First message — agent greeting"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="{StaticResource App.Text}"
                     Padding="28,26" />
        </Border>

        <StackPanel Grid.Row="2"
                    Margin="2,18,2,0">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Suggestions.Count, Mode=OneWay}" Value="0">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <TextBlock Text="LOCAL SUGGESTIONS"
                       Style="{StaticResource App.Eyebrow}"
                       Margin="0,0,0,7" />
            <ListBox x:Name="Suggestions"
                     MaxHeight="240"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesignListBoxItem}">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,3" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource App.Tint}"
                                BorderBrush="{StaticResource App.Line}"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="16,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="InformationOutline"
                                                         Width="16" Height="16"
                                                         Margin="0,1,12,0"
                                                         VerticalAlignment="Top"
                                                         Foreground="#8A9B77" />
                                <StackPanel Grid.Column="1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding FieldName}"
                                                   FontWeight="Medium"
                                                   FontSize="11.5"
                                                   LineHeight="18"
                                                   Foreground="{StaticResource App.Text}"
                                                   VerticalAlignment="Center" />
                                        <!-- 1px vertical padding was too tight
                                             for 9px caps; see the same fix in
                                             SystemPromptTabView. -->
                                        <Border Background="#EFF1E4"
                                                CornerRadius="4"
                                                Padding="7,3"
                                                Margin="9,0,0,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Severity}"
                                                       FontSize="9"
                                                       LineHeight="12"
                                                       Foreground="#7C875F" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Rationale}"
                                               TextWrapping="Wrap"
                                               FontSize="11"
                                               LineHeight="18"
                                               Margin="0,5,0,0"
                                               Foreground="{StaticResource App.Ink2}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
    </Grid>
</UserControl>
