<UserControl x:Class="ElevenLabsStudio.Views.AgentDetail.FirstMessageTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid Margin="0,12,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Paper-style editor mirroring the system prompt tab. -->
        <Border Grid.Row="0"
                CornerRadius="8"
                Background="{StaticResource App.SurfaceAlt}"
                BorderThickness="1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="Transparent" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=FirstMessage}" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource App.AccentBorder}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBox x:Name="FirstMessage"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     materialDesign:HintAssist.Hint="First message — agent greeting"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="{StaticResource App.Text}"
                     FontSize="13"
                     MinHeight="104"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalContentAlignment="Top"
                     Padding="12,14" />
        </Border>

        <!-- Meta line: suggestions count on the left, char counter on the
             right. Same Auto-row layout as the system prompt tab so the
             meta hugs the editor instead of sliding to the bottom. -->
        <DockPanel Grid.Row="1" Margin="2,12,2,0" LastChildFill="True">
            <Border DockPanel.Dock="Right"
                    Background="{StaticResource App.Surface}"
                    Padding="8,2"
                    BorderBrush="{StaticResource App.Border}"
                    BorderThickness="1"
                    CornerRadius="6">
                <TextBlock x:Name="FirstMessageLength"
                           Text="0 chars"
                           FontSize="11"
                           Foreground="{StaticResource App.TextSecondary}"
                           VerticalAlignment="Center" />
            </Border>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Local suggestions"
                           FontWeight="SemiBold"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource App.Text}" />
                <Border Style="{StaticResource App.Badge}" Margin="8,0,0,0" Padding="7,2">
                    <TextBlock Text="{Binding Suggestions.Count, Mode=OneWay}"
                               FontSize="11"
                               Foreground="{StaticResource App.TextSecondary}" />
                </Border>
            </StackPanel>
        </DockPanel>
    </Grid>
</UserControl>
