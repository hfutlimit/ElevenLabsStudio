<UserControl x:Class="ElevenLabsStudio.Views.AgentDetail.WorkflowTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             AutomationProperties.Name="Workflow board">
    <Border Margin="0,12,0,0"
            Padding="10"
            Background="{StaticResource App.Surface}"
            BorderBrush="{StaticResource App.Border}"
            BorderThickness="1"
            CornerRadius="12">
        <TabControl Background="Transparent"
                    BorderThickness="0"
                    ItemContainerStyle="{StaticResource App.TabItem}">
        <TabItem AutomationProperties.Name="Workflow canvas" Header="Workflow canvas">
            <Grid Margin="0,12,0,0">
                <Border x:Name="WorkflowCanvasFrame"
                        Style="{StaticResource App.SectionCard}"
                        Background="{StaticResource App.Canvas}"
                        BorderBrush="{StaticResource App.Border}"
                        Padding="0"
                        ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="{StaticResource App.SurfaceAlt}"
                                BorderBrush="{StaticResource App.Border}"
                                BorderThickness="0,0,0,1"
                                Padding="14,9">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right"
                                           Text="CONNECTIONS READ-ONLY"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource App.TextSecondary}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="Nodes are editable; connections are rendered from the server workflow."
                                           FontSize="11"
                                           Foreground="{StaticResource App.TextSecondary}"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>

                        <ScrollViewer Grid.Row="1"
                                      Padding="8"
                                      Background="{StaticResource App.Canvas}"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto">
                            <Grid Width="{Binding CanvasWidth}"
                                  Height="{Binding CanvasHeight}">
                                <Canvas x:Name="EdgeCanvas"
                                        Panel.ZIndex="0"
                                        IsHitTestVisible="False" />

                                <ItemsControl x:Name="NodesItems"
                                              Panel.ZIndex="1"
                                              ItemsSource="{Binding CanvasNodes}"
                                              AutomationProperties.Name="Workflow nodes">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding X}" />
                                            <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="236"
                                                    Height="108"
                                                    Padding="14"
                                                    Style="{StaticResource App.ElevatedCard}"
                                                    AutomationProperties.Name="{Binding Name}">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <DockPanel Grid.Row="0">
                                                        <Button DockPanel.Dock="Right"
                                                                Click="RemoveCanvasNode_Click"
                                                                Tag="{Binding Id}"
                                                                Style="{StaticResource App.IconButton}"
                                                                Width="26"
                                                                Height="26"
                                                                Foreground="{StaticResource App.Danger}"
                                                                ToolTip="Remove node"
                                                                AutomationProperties.Name="{Binding Name, StringFormat='Remove node {0}'}">
                                                            <materialDesign:PackIcon Kind="TrashCanOutline"
                                                                                     Width="14" Height="14" />
                                                        </Button>
                                                        <Border Style="{StaticResource App.Badge}"
                                                                Padding="7,3"
                                                                HorizontalAlignment="Left">
                                                            <TextBlock Text="{Binding Type}"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource App.TextSecondary}" />
                                                        </Border>
                                                    </DockPanel>

                                                    <TextBlock Grid.Row="1"
                                                               Text="{Binding Name}"
                                                               Margin="0,10,0,4"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource App.Text}"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Row="2"
                                                               Text="{Binding Id}"
                                                               FontSize="11"
                                                               Foreground="{StaticResource App.TextMuted}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </ScrollViewer>

                        <Button x:Name="AddNode"
                                Grid.Row="1"
                                Panel.ZIndex="4"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,14,18,0"
                                Style="{StaticResource App.PrimaryButton}"
                                Padding="12,0"
                                ToolTip="Add a new workflow node">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Plus" Width="14" Height="14" Margin="0,0,5,0" />
                                <TextBlock Text="Add node" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </TabItem>

        <TabItem AutomationProperties.Name="Raw JSON" Header="Raw JSON">
            <Grid Margin="0,12,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Margin="0,0,0,10"
                        Padding="12,10"
                        Background="{StaticResource App.SurfaceAlt}"
                        CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="Raw workflow JSON"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Foreground="{StaticResource App.Text}" />
                        <TextBlock Text="Complete server document · read-only"
                                   Margin="0,2,0,0"
                                   FontSize="11"
                                   Foreground="{StaticResource App.TextSecondary}" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1"
                        Style="{StaticResource App.SectionCard}"
                        Background="{StaticResource App.Surface}"
                        Padding="12">
                    <TextBox x:Name="RawJson"
                             AutomationProperties.Name="Raw workflow JSON"
                             IsReadOnly="True"
                             Text="{Binding RawJson, Mode=OneWay}"
                             FontFamily="Consolas, Cascadia Mono, monospace"
                             FontSize="11"
                             BorderThickness="0"
                             Background="Transparent"
                             Foreground="{StaticResource App.TextSecondary}"
                             TextWrapping="NoWrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top" />
                </Border>
            </Grid>
        </TabItem>
        </TabControl>
    </Border>
</UserControl>
