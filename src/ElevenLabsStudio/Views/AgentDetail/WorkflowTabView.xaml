<UserControl x:Class="ElevenLabsStudio.Views.AgentDetail.WorkflowTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:domain="clr-namespace:ElevenLabsStudio.Core.Domain;assembly=ElevenLabsStudio.Core">
    <Grid Margin="0,14,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
        </Grid.RowDefinitions>

        <!-- Header with Add Node -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <Button x:Name="AddNode"
                    DockPanel.Dock="Right"
                    Style="{StaticResource App.PrimaryButton}"
                    Margin="8,0,0,0"
                    Padding="12,0">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Plus" Width="14" Height="14" Margin="0,0,5,0" />
                    <TextBlock Text="添加节点" />
                </StackPanel>
            </Button>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <materialDesign:PackIcon Kind="GraphOutline"
                                         Width="16" Height="16"
                                         Margin="0,0,7,0"
                                         Foreground="{StaticResource App.Accent}" />
                <TextBlock Text="节点序列"
                           FontWeight="SemiBold"
                           FontSize="12"
                           Foreground="{StaticResource App.Text}" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource App.SectionCard}" Padding="1">
        <DataGrid
                  x:Name="NodesGrid"
                  ItemsSource="{Binding Nodes}"
                  Style="{StaticResource App.DataGrid}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id"
                                    Binding="{Binding Id, UpdateSourceTrigger=PropertyChanged}"
                                    Width="120" />
                <DataGridTextColumn Header="Type"
                                    Binding="{Binding Type, UpdateSourceTrigger=PropertyChanged}"
                                    Width="140" />
                <DataGridTextColumn Header="Name"
                                    Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                    Width="*" />
                <DataGridTemplateColumn Header="" Width="56">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button
                                    Click="RemoveNode_Click"
                                    Tag="{Binding}"
                                    Style="{StaticResource App.IconButton}"
                                    Width="28" Height="28"
                                    Foreground="{StaticResource App.Danger}"
                                    ToolTip="删除节点">
                                <materialDesign:PackIcon Kind="TrashCanOutline" Width="14" Height="14" />
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="2,14,0,6">
            <materialDesign:PackIcon Kind="CodeJson"
                                     Width="15" Height="15"
                                     Margin="0,0,7,0"
                                     Foreground="{StaticResource App.Accent}" />
            <TextBlock Text="Raw JSON · 只读"
                       FontWeight="SemiBold"
                       FontSize="12"
                       Foreground="{StaticResource App.TextSecondary}" />
        </StackPanel>

        <Border Grid.Row="3" Style="{StaticResource App.SectionCard}" Padding="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto">
                <TextBox x:Name="RawJson"
                         IsReadOnly="True"
                         FontFamily="Consolas, Cascadia Mono, monospace"
                         FontSize="11"
                         BorderThickness="0"
                         Background="Transparent"
                         Foreground="{StaticResource App.TextSecondary}"
                         TextWrapping="NoWrap"
                         AcceptsReturn="True" />
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
