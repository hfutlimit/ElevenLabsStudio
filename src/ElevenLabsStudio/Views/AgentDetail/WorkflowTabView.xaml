<UserControl x:Class="ElevenLabsStudio.Views.AgentDetail.WorkflowTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             AutomationProperties.Name="Workflow board">
    <Grid Margin="0,14,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1.1*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <Button x:Name="AddNode"
                    DockPanel.Dock="Right"
                    Style="{StaticResource App.PrimaryButton}"
                    Margin="8,0,0,0"
                    Padding="12,0"
                    ToolTip="Add a new workflow node">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Plus" Width="14" Height="14" Margin="0,0,5,0" />
                    <TextBlock Text="Add node" />
                </StackPanel>
            </Button>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Style="{StaticResource App.Badge}"
                        Padding="7"
                        Margin="0,0,9,0">
                    <materialDesign:PackIcon Kind="GraphOutline"
                                             Width="16"
                                             Height="16"
                                             Foreground="{StaticResource App.Accent}" />
                </Border>
                <StackPanel>
                    <TextBlock Text="Workflow flow"
                               FontWeight="SemiBold"
                               FontSize="13"
                               Foreground="{StaticResource App.Text}" />
                    <TextBlock Text="Connected nodes from the server layout"
                               Margin="0,2,0,0"
                               FontSize="11"
                               Foreground="{StaticResource App.TextSecondary}" />
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1"
                Style="{StaticResource App.SectionCard}"
                Padding="0"
                ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{StaticResource App.AccentSoft}"
                        BorderBrush="{StaticResource App.AccentBorder}"
                        BorderThickness="0,0,0,1"
                        Padding="14,9">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right"
                                   Text="READ-ONLY GRAPH"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource App.Accent}"
                                   VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="InformationOutline"
                                                     Width="14"
                                                     Height="14"
                                                     Margin="0,0,7,0"
                                                     Foreground="{StaticResource App.Accent}"
                                                     VerticalAlignment="Center" />
                            <TextBlock Text="Lines represent the workflow edges. New nodes are laid out automatically."
                                       FontSize="11"
                                       Foreground="{StaticResource App.TextSecondary}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <ScrollViewer Grid.Row="1"
                              Padding="8"
                              Background="{StaticResource App.Canvas}"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                    <Grid Width="{Binding CanvasWidth}"
                          Height="{Binding CanvasHeight}">
                        <Canvas x:Name="EdgeCanvas"
                                Panel.ZIndex="0"
                                IsHitTestVisible="False" />

                        <ItemsControl x:Name="NodesItems"
                                      Panel.ZIndex="1"
                                      ItemsSource="{Binding CanvasNodes}"
                                      AutomationProperties.Name="Workflow nodes">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding X}" />
                                    <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="236"
                                            Height="108"
                                            Padding="14"
                                            Style="{StaticResource App.ElevatedCard}"
                                            AutomationProperties.Name="{Binding Name}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <DockPanel Grid.Row="0">
                                                <Button DockPanel.Dock="Right"
                                                        Click="RemoveCanvasNode_Click"
                                                        Tag="{Binding Id}"
                                                        Style="{StaticResource App.IconButton}"
                                                        Width="26"
                                                        Height="26"
                                                        Foreground="{StaticResource App.Danger}"
                                                        ToolTip="Remove node"
                                                        AutomationProperties.Name="{Binding Name, StringFormat='Remove node {0}'}">
                                                    <materialDesign:PackIcon Kind="TrashCanOutline"
                                                                             Width="14"
                                                                             Height="14" />
                                                </Button>
                                                <Border Style="{StaticResource App.Badge}"
                                                        Padding="7,3"
                                                        HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding Type}"
                                                               FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource App.Accent}" />
                                                </Border>
                                            </DockPanel>

                                            <TextBlock Grid.Row="1"
                                                       Text="{Binding Name}"
                                                       Margin="0,10,0,4"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource App.Text}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Row="2"
                                                       Text="{Binding Id}"
                                                       FontSize="10"
                                                       Foreground="{StaticResource App.TextSecondary}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Margin="2,14,0,6">
            <materialDesign:PackIcon Kind="CodeJson"
                                     Width="15"
                                     Height="15"
                                     Margin="0,0,7,0"
                                     Foreground="{StaticResource App.Accent}" />
            <TextBlock Text="Raw JSON · read-only"
                       FontWeight="SemiBold"
                       FontSize="12"
                       Foreground="{StaticResource App.TextSecondary}" />
        </StackPanel>

        <Border Grid.Row="3"
                Style="{StaticResource App.SectionCard}"
                Padding="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto">
                <TextBox x:Name="RawJson"
                         IsReadOnly="True"
                         Text="{Binding RawJson, Mode=OneWay}"
                         FontFamily="Consolas, Cascadia Mono, monospace"
                         FontSize="11"
                         BorderThickness="0"
                         Background="Transparent"
                         Foreground="{StaticResource App.TextSecondary}"
                         TextWrapping="NoWrap"
                         AcceptsReturn="True" />
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
