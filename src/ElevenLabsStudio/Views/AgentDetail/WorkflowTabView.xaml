<UserControl x:Class="ElevenLabsStudio.Views.AgentDetail.WorkflowTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:cal="http://www.caliburnproject.org"
             AutomationProperties.Name="Workflow board">
    <Border Margin="0,12,0,0"
            Padding="10"
            Background="{StaticResource App.Surface}"
            BorderBrush="{StaticResource App.Border}"
            BorderThickness="1"
            CornerRadius="12">
        <TabControl Background="Transparent"
                    BorderThickness="0"
                    ItemContainerStyle="{StaticResource App.TabItem}">
        <TabItem AutomationProperties.Name="Workflow canvas" Header="Workflow canvas">
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="300" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="300" MinWidth="240" MaxWidth="560" />
                </Grid.ColumnDefinitions>

                <Border x:Name="WorkflowCanvasFrame"
                        Grid.Column="0"
                        Style="{StaticResource App.SectionCard}"
                        Background="{StaticResource App.Canvas}"
                        Padding="0"
                        ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="{StaticResource App.SurfaceAlt}"
                                BorderBrush="{StaticResource App.Border}"
                                BorderThickness="0,0,0,1"
                                Padding="14,9">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right"
                                           Text="CONNECTIONS READ-ONLY"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource App.TextSecondary}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="Click a node or a connection to inspect it."
                                           FontSize="11"
                                           Foreground="{StaticResource App.TextSecondary}"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>

                        <ScrollViewer Grid.Row="1"
                                      Padding="8"
                                      Background="{StaticResource App.Canvas}"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto">
                            <Grid Width="{Binding CanvasWidth}"
                                  Height="{Binding CanvasHeight}">
                                <Canvas x:Name="EdgeCanvas"
                                        Panel.ZIndex="0" />

                                <ItemsControl x:Name="NodesItems"
                                              Panel.ZIndex="1"
                                              ItemsSource="{Binding CanvasNodes}"
                                              AutomationProperties.Name="Workflow nodes">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding X}" />
                                            <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="236"
                                                    Height="64"
                                                    Padding="12,10"
                                                    Cursor="Hand"
                                                    cal:Message.Attach="[Event MouseLeftButtonUp] = [Action SelectNode($dataContext)]"
                                                    AutomationProperties.Name="{Binding DisplayName}"
                                                    Tag="{Binding Id}">
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource App.ElevatedCard}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="BorderBrush" Value="{StaticResource App.Accent}" />
                                                                <Setter Property="BorderThickness" Value="2" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                    </Grid.RowDefinitions>

                                                    <DockPanel Grid.Row="0">
                                                        <Button DockPanel.Dock="Right"
                                                                Click="RemoveCanvasNode_Click"
                                                                Tag="{Binding Id}"
                                                                Style="{StaticResource App.IconButton}"
                                                                Width="26"
                                                                Height="26"
                                                                Foreground="{StaticResource App.Danger}"
                                                                ToolTip="Remove node"
                                                                AutomationProperties.Name="{Binding Id, StringFormat='Remove node {0}'}">
                                                            <materialDesign:PackIcon Kind="TrashCanOutline"
                                                                                     Width="14" Height="14" />
                                                        </Button>
                                                        <Border Style="{StaticResource App.Badge}"
                                                                Padding="7,3"
                                                                HorizontalAlignment="Left">
                                                            <TextBlock Text="{Binding Type}"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource App.TextSecondary}" />
                                                        </Border>
                                                    </DockPanel>

                                                    <TextBlock Grid.Row="1"
                                                               Text="{Binding DisplayName}"
                                                               Margin="0,4,0,0"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource App.Text}"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </ScrollViewer>

                        <Button x:Name="AddNode"
                                Grid.Row="1"
                                Panel.ZIndex="4"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,14,18,0"
                                Style="{StaticResource App.PrimaryButton}"
                                Padding="12,0"
                                ToolTip="Add a new workflow node">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Plus" Width="14" Height="14" Margin="0,0,5,0" />
                                <TextBlock Text="Add node" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- Drag to widen/narrow the inspector. Hidden together
                     with the inspector when nothing is selected. -->
                <GridSplitter x:Name="InspectorSplitter"
                              Grid.Column="1"
                              Width="6"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Stretch"
                              ResizeDirection="Columns"
                              ResizeBehavior="PreviousAndNext"
                              Background="{StaticResource App.Border}"
                              ShowsPreview="True"
                              Visibility="{Binding HasInspector, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <!-- Inspector: shows the selected node or connection. -->
                <Border x:Name="WorkflowInspector"
                        Grid.Column="2"
                        Margin="8,0,0,0"
                        Style="{StaticResource App.SectionCard}"
                        Padding="16"
                        Visibility="{Binding HasInspector, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <StackPanel x:Name="NodeInspector"
                                    Visibility="{Binding HasSelectedNode, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <DockPanel Margin="0,0,0,10">
                                <Button DockPanel.Dock="Right"
                                        x:Name="NodeInspectorClose"
                                        cal:Message.Attach="[Event Click] = [Action ClearSelection()]"
                                        Style="{StaticResource App.IconButton}"
                                        Width="26" Height="26"
                                        ToolTip="Close inspector"
                                        AutomationProperties.Name="Close node inspector">
                                    <materialDesign:PackIcon Kind="Close" Width="14" Height="14" />
                                </Button>
                                <TextBlock Text="Node"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource App.Text}"
                                           VerticalAlignment="Center" />
                            </DockPanel>

                            <Border Style="{StaticResource App.Badge}" Padding="8,3" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding SelectedNode.Type}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource App.TextSecondary}" />
                            </Border>

                            <TextBlock Text="Name"
                                       FontSize="11"
                                       Foreground="{StaticResource App.TextMuted}"
                                       Margin="0,10,0,3" />
                            <TextBox Text="{Binding SelectedNodeName, Mode=TwoWay}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     MinHeight="34"
                                     Padding="8,0"
                                     HorizontalContentAlignment="Left" />

                            <TextBlock Text="Connections"
                                       FontSize="11"
                                       Foreground="{StaticResource App.TextMuted}"
                                       Margin="0,12,0,4" />
                            <ItemsControl ItemsSource="{Binding SelectedNodeConnections}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"
                                                   FontSize="11"
                                                   FontFamily="Consolas, Cascadia Mono, monospace"
                                                   Foreground="{StaticResource App.TextSecondary}"
                                                   Margin="0,0,0,4"
                                                   TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel x:Name="EdgeInspector"
                                    Visibility="{Binding HasSelectedEdge, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <DockPanel Margin="0,0,0,10">
                                <Button DockPanel.Dock="Right"
                                        x:Name="EdgeInspectorClose"
                                        cal:Message.Attach="[Event Click] = [Action ClearSelection()]"
                                        Style="{StaticResource App.IconButton}"
                                        Width="26" Height="26"
                                        ToolTip="Close inspector"
                                        AutomationProperties.Name="Close connection inspector">
                                    <materialDesign:PackIcon Kind="Close" Width="14" Height="14" />
                                </Button>
                                <TextBlock Text="Connection"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource App.Text}"
                                           VerticalAlignment="Center" />
                            </DockPanel>

                            <Border Style="{StaticResource App.Badge}" Padding="8,3" HorizontalAlignment="Left" Margin="0,0,0,10">
                                <TextBlock Text="{Binding SelectedEdge.ConditionKind}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource App.TextSecondary}" />
                            </Border>

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding SelectedEdge.SourceName}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource App.Text}" />
                                <TextBlock Text="  →  "
                                           FontSize="12"
                                           Foreground="{StaticResource App.TextMuted}" />
                                <TextBlock Text="{Binding SelectedEdge.TargetName}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource App.Text}" />
                            </StackPanel>

                            <TextBlock Text="{Binding SelectedEdge.ConditionLabel}"
                                       FontSize="11"
                                       FontStyle="Italic"
                                       Foreground="{StaticResource App.TextMuted}"
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap" />

                            <TextBlock Text="Condition"
                                       FontSize="11"
                                       Foreground="{StaticResource App.TextMuted}"
                                       Margin="0,12,0,4" />
                            <ScrollViewer MaxHeight="320"
                                          VerticalScrollBarVisibility="Auto">
                                <TextBlock Text="{Binding SelectedEdge.ConditionText, TargetNullValue='—'}"
                                           FontSize="11"
                                           LineHeight="17"
                                           Foreground="{StaticResource App.TextSecondary}"
                                           TextWrapping="Wrap" />
                            </ScrollViewer>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </TabItem>

        <TabItem AutomationProperties.Name="Raw JSON" Header="Raw JSON">
            <Grid Margin="0,12,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Margin="0,0,0,10"
                        Padding="12,10"
                        Background="{StaticResource App.SurfaceAlt}"
                        CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="Raw workflow JSON"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Foreground="{StaticResource App.Text}" />
                        <TextBlock Text="Complete server document · read-only"
                                   Margin="0,2,0,0"
                                   FontSize="11"
                                   Foreground="{StaticResource App.TextSecondary}" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1"
                        Style="{StaticResource App.SectionCard}"
                        Background="{StaticResource App.Surface}"
                        Padding="12">
                    <TextBox x:Name="RawJson"
                             AutomationProperties.Name="Raw workflow JSON"
                             IsReadOnly="True"
                             Text="{Binding RawJson, Mode=OneWay}"
                             FontFamily="Consolas, Cascadia Mono, monospace"
                             FontSize="11"
                             BorderThickness="0"
                             Background="Transparent"
                             Foreground="{StaticResource App.TextSecondary}"
                             TextWrapping="NoWrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top" />
                </Border>
            </Grid>
        </TabItem>
        </TabControl>
    </Border>
</UserControl>
