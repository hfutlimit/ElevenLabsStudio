<!-- Each parameter is one row: a fixed label column and a value field
     of the same height. ClampToWorkArea shrinks the window on a short
     screen so the footer stays inside the work area. -->
<UserControl x:Class="ElevenLabsStudio.Views.AgentDetail.DynamicVariablesDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="760" Height="720"
             MinWidth="520" MinHeight="400"
             Background="{StaticResource App.Canvas}">
    <UserControl.Resources>
        <Style x:Key="ParameterLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource App.MonoFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource App.Ink2}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Margin" Value="0,0,16,0" />
        </Style>
        <Style x:Key="ParameterValue" TargetType="TextBox">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource App.Text}" />
            <Setter Property="CaretBrush" Value="{StaticResource App.Text}" />
            <Setter Property="Background" Value="{StaticResource App.Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource App.Frame}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource App.Signal}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="{Binding ScenarioName}" FontSize="18" FontWeight="SemiBold"
                       Foreground="{StaticResource App.Text}" />
            <TextBlock Text="Parameters for the next conversation" Margin="0,4,0,0"
                       Foreground="{StaticResource App.TextMuted}" FontSize="12" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding DynamicVariables}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="36" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="196" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Key}" Style="{StaticResource ParameterLabel}"
                                           ToolTip="{Binding Key}" />
                                <TextBox Grid.Column="1"
                                         Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ParameterValue}"
                                         ToolTip="{Binding Value}"
                                         AutomationProperties.Name="{Binding Key}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
        <TextBlock Grid.Row="2" Text="{Binding Error}" Foreground="{StaticResource App.Danger}"
                   TextWrapping="Wrap" Margin="0,8,0,0" />
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CancelAsync" Content="Cancel" IsCancel="True"
                    Style="{StaticResource App.SecondaryButton}" Margin="0,0,10,0" />
            <Button x:Name="SaveAsync" Content="Save parameters" Style="{StaticResource App.PrimaryButton}" />
        </StackPanel>
    </Grid>
</UserControl>
