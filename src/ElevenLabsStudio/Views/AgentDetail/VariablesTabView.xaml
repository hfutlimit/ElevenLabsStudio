<UserControl x:Class="ElevenLabsStudio.Views.AgentDetail.VariablesTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid Margin="0,12,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header with Add Variable -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <Button x:Name="AddVariable"
                    DockPanel.Dock="Right"
                    Content="+ 添加变量"
                    Height="32"
                    Padding="12,0"
                    Margin="8,0,0,0"
                    Background="{StaticResource App.Accent}"
                    Foreground="White"
                    BorderThickness="0" />
            <TextBlock Text="Prompt 变量"
                       FontWeight="SemiBold"
                       FontSize="12"
                       Foreground="{StaticResource App.Text}"
                       VerticalAlignment="Center" />
        </DockPanel>

        <!-- Editable DataGrid -->
        <DataGrid Grid.Row="1"
                  x:Name="VariablesGrid"
                  ItemsSource="{Binding Variables}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  Background="{StaticResource App.SurfaceAlt}"
                  BorderBrush="{StaticResource App.Border}"
                  BorderThickness="1"
                  GridLinesVisibility="Horizontal"
                  RowBackground="{StaticResource App.Surface}"
                  AlternatingRowBackground="{StaticResource App.SurfaceAlt}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name"
                                    Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                    Width="160" />
                <DataGridTextColumn Header="Value"
                                    Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                    Width="*" />
                <DataGridTextColumn Header="Type"
                                    Binding="{Binding Type, UpdateSourceTrigger=PropertyChanged}"
                                    Width="120" />
                <DataGridTemplateColumn Header="" Width="56">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="✕"
                                    Click="RemoveVariable_Click"
                                    Tag="{Binding}"
                                    Width="28" Height="28"
                                    Background="Transparent"
                                    Foreground="{StaticResource App.Danger}"
                                    BorderThickness="0"
                                    ToolTip="删除变量" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>