<UserControl x:Class="ElevenLabsStudio.Views.AgentDetail.VariablesTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid Margin="0,14,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header with Add Variable -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <Button x:Name="AddVariable"
                    DockPanel.Dock="Right"
                    Style="{StaticResource App.PrimaryButton}"
                    Margin="8,0,0,0"
                    Padding="12,0">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Plus" Width="14" Height="14" Margin="0,0,5,0" />
                    <TextBlock Text="添加变量" />
                </StackPanel>
            </Button>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <materialDesign:PackIcon Kind="VariableBox"
                                         Width="16" Height="16"
                                         Margin="0,0,7,0"
                                         Foreground="{StaticResource App.Accent}" />
                <TextBlock Text="Prompt 变量"
                           FontWeight="SemiBold"
                           FontSize="12"
                           Foreground="{StaticResource App.Text}" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource App.SectionCard}" Padding="1">
        <DataGrid
                  x:Name="VariablesGrid"
                  ItemsSource="{Binding Variables}"
                  Style="{StaticResource App.DataGrid}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name"
                                    Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                    Width="160" />
                <DataGridTextColumn Header="Value"
                                    Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                    Width="*" />
                <DataGridTextColumn Header="Type"
                                    Binding="{Binding Type, UpdateSourceTrigger=PropertyChanged}"
                                    Width="120" />
                <DataGridTemplateColumn Header="" Width="56">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button
                                    Click="RemoveVariable_Click"
                                    Tag="{Binding}"
                                    Style="{StaticResource App.IconButton}"
                                    Width="28" Height="28"
                                    Foreground="{StaticResource App.Danger}"
                                    ToolTip="删除变量">
                                <materialDesign:PackIcon Kind="TrashCanOutline" Width="14" Height="14" />
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        </Border>
    </Grid>
</UserControl>
