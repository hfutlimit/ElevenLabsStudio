<UserControl x:Class="ElevenLabsStudio.Views.AgentDetail.VariablesTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:cal="http://www.caliburnproject.org">
    <Grid Margin="0,14,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Action row. "Prompt variables" was the tab header restated, and
             its VariableBox icon travelled with it, so both are gone;
             Reset and Add variable stay right-aligned. -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="ResetVariables"
                        Content="Reset"
                        Style="{StaticResource App.GhostButton}"
                        FontSize="11.5"
                        Height="24"
                        Padding="10,0"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        cal:Message.Attach="[Event Click] = [Action ResetToServer()]"
                        Visibility="{Binding IsDirty, Converter={StaticResource BooleanToVisibilityConverter}}"
                        ToolTip="Discard local edits and restore the server variables"
                        AutomationProperties.Name="Reset variables" />
                <Button x:Name="AddVariable"
                        Style="{StaticResource App.PrimaryButton}"
                        Padding="12,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Plus" Width="14" Height="14" Margin="0,0,5,0" />
                        <TextBlock Text="Add variable" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Background="{StaticResource App.Surface}"
                BorderBrush="{StaticResource App.Line}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="1">
        <DataGrid
                  x:Name="VariablesGrid"
                  ItemsSource="{Binding Variables}"
                  Style="{StaticResource App.DataGrid}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name"
                                    Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                    Width="160" />
                <DataGridTextColumn Header="Value"
                                    Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                    Width="*" />
                <DataGridTextColumn Header="Type"
                                    Binding="{Binding Type, UpdateSourceTrigger=PropertyChanged}"
                                    Width="120" />
                <DataGridTemplateColumn Header="" Width="56">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button
                                    Click="RemoveVariable_Click"
                                    Tag="{Binding}"
                                    Style="{StaticResource App.IconButton}"
                                    Width="28" Height="28"
                                    Foreground="{StaticResource App.Danger}"
                                    ToolTip="Delete variable">
                                <materialDesign:PackIcon Kind="TrashCanOutline" Width="14" Height="14" />
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        </Border>
    </Grid>
</UserControl>
