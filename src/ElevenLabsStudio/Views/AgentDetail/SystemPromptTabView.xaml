<UserControl x:Class="ElevenLabsStudio.Views.AgentDetail.SystemPromptTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:cal="http://www.caliburnproject.org">

    <!-- Route B follow-up. The editor is now a real field: a label row
         with the character count on the same line (was docked to the
         opposite edge of the pane via a LastChildFill DockPanel —
         review §3), a bordered paper surface (was invisible until
         focused — §4), and a suggestions section that fully collapses
         when there is nothing to say (§11) and grows instead of
         reserving a fixed 144 px. Each suggestion carries a 3px
         severity bar so the eye can scan the list without opening
         each row (§13). -->

    <!-- AgentDetailView owns the centered measure cap. Stretch this
         entire column so the editor width does not depend on its text. -->
    <Grid HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="180" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Meta row. The tab header already says "System Prompt", so
             repeating it here was noise; the character count takes the
             left edge where the title used to sit, and Reset stays on
             the right so the row still reads as left-info / right-action. -->
        <Grid Grid.Row="0" Margin="2,0,2,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="PromptLength"
                       Text="0 chars"
                       FontFamily="Consolas, Cascadia Mono, monospace"
                       FontSize="11.5"
                       Foreground="{StaticResource App.Ink3}"
                       VerticalAlignment="Center" />
            <Button Grid.Column="1"
                    Content="Reset"
                    Style="{StaticResource App.GhostButton}"
                    FontSize="11.5"
                    Height="24"
                    Padding="10,0"
                    VerticalAlignment="Center"
                    cal:Message.Attach="[Event Click] = [Action ResetToServer()]"
                    Visibility="{Binding HasLocalEdits, Converter={StaticResource BooleanToVisibilityConverter}}"
                    ToolTip="Discard local edits and restore the server value"
                    AutomationProperties.Name="Reset system prompt" />
        </Grid>

        <!-- Editor with hairline frame. Focus ring is provided by the
             App.InsetEditor trigger on IsKeyboardFocusWithin.
             ClipToBounds: MaterialDesign's TextBox template keeps an
             empty helper/validation footer row that it lays out below
             the control once the box is stretched to fill the row, so
             the editor painted ~22px past the frame and into the tab
             footer. These editors carry no validation text, so clipping
             that empty row costs nothing. -->
        <Border Grid.Row="1"
                ClipToBounds="True"
                Style="{StaticResource App.InsetEditor}">
            <!-- Inherited text-layout properties set a 22px line height
                 for the 13px prompt, keeping long instructions readable. -->
            <TextBox x:Name="Prompt"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     FontFamily="{StaticResource App.MonoFont}"
                     FontSize="13"
                     TextBlock.LineHeight="22"
                     TextBlock.LineStackingStrategy="BlockLineHeight"
                     materialDesign:HintAssist.Hint="System prompt"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="{StaticResource App.Text}"
                     Padding="28,26" />
        </Border>

        <!-- Suggestions section, collapsed when the list is empty. -->
        <StackPanel Grid.Row="2"
                    Margin="2,18,2,0">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Suggestions.Count, Mode=OneWay}" Value="0">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <TextBlock Text="LOCAL SUGGESTIONS"
                       Style="{StaticResource App.Eyebrow}"
                       Margin="0,0,0,7" />
            <ListBox x:Name="Suggestions"
                     MaxHeight="240"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesignListBoxItem}">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,3" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource App.Tint}"
                                BorderBrush="{StaticResource App.Line}"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="16,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="InformationOutline"
                                                         Width="16" Height="16"
                                                         Margin="0,1,12,0"
                                                         VerticalAlignment="Top"
                                                         Foreground="#8A9B77" />
                                <StackPanel Grid.Column="1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding FieldName}"
                                                   FontWeight="Medium"
                                                   FontSize="11.5"
                                                   LineHeight="18"
                                                   Foreground="{StaticResource App.Text}"
                                                   VerticalAlignment="Center" />
                                        <!-- Vertical padding 1px was too tight for
                                             9px caps and read as a smudge. -->
                                        <Border Background="#EFF1E4"
                                                CornerRadius="4"
                                                Padding="7,3"
                                                Margin="9,0,0,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Severity}"
                                                       FontSize="9"
                                                       LineHeight="12"
                                                       Foreground="#7C875F" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Rationale}"
                                               TextWrapping="Wrap"
                                               FontSize="11"
                                               LineHeight="18"
                                               Margin="0,5,0,0"
                                               Foreground="{StaticResource App.Ink2}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
    </Grid>
</UserControl>
