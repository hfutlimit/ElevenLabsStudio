<UserControl x:Class="ElevenLabsStudio.Views.AgentDetail.SystemPromptTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid Margin="0,14,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="160" />
        </Grid.RowDefinitions>

        <TextBox Grid.Row="0"
                 x:Name="Prompt"
                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 FontFamily="Consolas, Cascadia Mono, monospace"
                 FontSize="13"
                 materialDesign:HintAssist.Hint="System prompt"
                 Background="{StaticResource App.Surface}"
                 BorderBrush="{StaticResource App.BorderStrong}"
                 Foreground="{StaticResource App.Text}"
                 Padding="12" />

        <DockPanel Grid.Row="0" Margin="0,0,0,0" LastChildFill="True"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Border DockPanel.Dock="Right"
                    Background="{StaticResource App.Surface}"
                    Padding="8,2"
                    BorderBrush="{StaticResource App.Border}"
                    BorderThickness="1"
                    CornerRadius="7">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="FormatLetterCase"
                                             Width="12" Height="12"
                                             Margin="0,0,4,0"
                                             VerticalAlignment="Center"
                                             Foreground="{StaticResource App.TextMuted}" />
                    <TextBlock x:Name="PromptLength"
                               Text="0 chars"
                               FontSize="11"
                               Foreground="{StaticResource App.TextSecondary}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </DockPanel>

        <DockPanel Grid.Row="1" Margin="2,14,2,5">
            <Border DockPanel.Dock="Right" Style="{StaticResource App.Badge}" Padding="7,2">
                <TextBlock Text="{Binding Suggestions.Count, Mode=OneWay}"
                           FontSize="10"
                           Foreground="{StaticResource App.Accent}" />
            </Border>
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="LightbulbOnOutline"
                                         Width="15" Height="15"
                                         Margin="0,0,6,0"
                                         Foreground="{StaticResource App.Warning}" />
                <TextBlock Text="Local suggestions"
                           FontWeight="SemiBold"
                           FontSize="12"
                           Foreground="{StaticResource App.Text}" />
            </StackPanel>
        </DockPanel>

        <ListBox Grid.Row="2"
                 x:Name="Suggestions"
                 Margin="0,4,0,0"
                 Background="Transparent"
                 BorderThickness="0">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesignListBoxItem}">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,2" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource App.SectionCard}" Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Grid.Column="0"
                                                     Margin="0,0,8,0"
                                                     VerticalAlignment="Top"
                                                     Foreground="{StaticResource App.TextSecondary}">
                                <materialDesign:PackIcon.Style>
                                    <Style TargetType="materialDesign:PackIcon">
                                        <Setter Property="Kind" Value="Information" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Severity}" Value="Suggestion">
                                                <Setter Property="Kind" Value="LightbulbOutline" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                                <Setter Property="Kind" Value="AlertOutline" />
                                                <Setter Property="Foreground" Value="{StaticResource App.Danger}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialDesign:PackIcon.Style>
                            </materialDesign:PackIcon>
                            <StackPanel Grid.Column="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding FieldName}"
                                               FontWeight="SemiBold"
                                               FontSize="12"
                                               Foreground="{StaticResource App.Text}" />
                                    <Border Style="{StaticResource App.Badge}" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding Severity}"
                                                   FontSize="10"
                                                   Foreground="{StaticResource App.Accent}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding Rationale}"
                                           TextWrapping="Wrap"
                                           FontSize="11"
                                           Foreground="{StaticResource App.TextSecondary}"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
