<UserControl x:Class="ElevenLabsStudio.Views.AgentDetail.SystemPromptTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <!-- Route B follow-up. The editor is now a real field: a label row
         with the character count on the same line (was docked to the
         opposite edge of the pane via a LastChildFill DockPanel —
         review §3), a bordered paper surface (was invisible until
         focused — §4), and a suggestions section that fully collapses
         when there is nothing to say (§11) and grows instead of
         reserving a fixed 144 px. Each suggestion carries a 3px
         severity bar so the eye can scan the list without opening
         each row (§13). -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="180" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Field label row: name + count share one line. -->
        <Grid Grid.Row="0" Margin="2,0,2,7">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="System prompt"
                       FontSize="12.5"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource App.Text}"
                       VerticalAlignment="Center" />
            <TextBlock x:Name="PromptLength"
                       Grid.Column="1"
                       Text="0 chars"
                       FontFamily="Consolas, Cascadia Mono, monospace"
                       FontSize="11"
                       Foreground="{StaticResource App.Ink3}"
                       VerticalAlignment="Center" />
        </Grid>

        <!-- Editor with hairline frame. Focus ring is provided by the
             App.InsetEditor trigger on IsKeyboardFocusWithin. -->
        <Border Grid.Row="1"
                Style="{StaticResource App.InsetEditor}">
            <TextBox x:Name="Prompt"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     FontFamily="{StaticResource App.MonoFont}"
                     FontSize="13"
                     materialDesign:HintAssist.Hint="System prompt"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="{StaticResource App.Text}"
                     Padding="24,22" />
        </Border>

        <!-- Suggestions section, collapsed when the list is empty. -->
        <StackPanel Grid.Row="2"
                    Margin="2,18,2,0">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Suggestions.Count, Mode=OneWay}" Value="0">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <TextBlock Text="LOCAL SUGGESTIONS"
                       Style="{StaticResource App.Eyebrow}"
                       Margin="0,0,0,7" />
            <ListBox x:Name="Suggestions"
                     MaxHeight="240"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesignListBoxItem}">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,3" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource App.Tint}"
                                BorderBrush="{StaticResource App.Line}"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="16,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="InformationOutline"
                                                         Width="16" Height="16"
                                                         Margin="0,1,12,0"
                                                         VerticalAlignment="Top"
                                                         Foreground="#8A9B77" />
                                <StackPanel Grid.Column="1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding FieldName}"
                                                   FontWeight="Medium"
                                                   FontSize="11.5"
                                                   Foreground="{StaticResource App.Text}"
                                                   VerticalAlignment="Center" />
                                        <Border Background="#EFF1E4"
                                                CornerRadius="4"
                                                Padding="6,1"
                                                Margin="9,1,0,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Severity}"
                                                       FontSize="9"
                                                       Foreground="#7C875F" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Rationale}"
                                               TextWrapping="Wrap"
                                               FontSize="11"
                                               LineHeight="18"
                                               Margin="0,5,0,0"
                                               Foreground="{StaticResource App.Ink2}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
    </Grid>
</UserControl>
