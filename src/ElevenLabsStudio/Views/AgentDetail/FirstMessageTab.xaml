<UserControl x:Class="ElevenLabsStudio.Views.AgentDetail.FirstMessageTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid Margin="0,12,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBox Grid.Row="0"
                 x:Name="FirstMessage"
                 materialDesign:HintAssist.Hint="First message — Agent 开场白"
                 FontSize="14"
                 Margin="0,0,0,8" />

        <materialDesign:Card Grid.Row="1" Padding="16" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="预览"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8" />
                <TextBlock Text="{Binding FirstMessage, Mode=OneWay}"
                           TextWrapping="Wrap"
                           FontSize="14"
                           Opacity="0.85" />
            </StackPanel>
        </materialDesign:Card>

        <TextBlock Grid.Row="2"
                   Margin="0,12,0,4"
                   FontWeight="SemiBold">
            <Run Text="Local Suggestions" />
            <Run Text="(" /><Run Text="{Binding Suggestions.Count, Mode=OneWay}" /><Run Text=")" />
        </TextBlock>
    </Grid>
</UserControl>