<UserControl x:Class="ElevenLabsStudio.Views.AgentDetail.FirstMessageTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid Margin="0,8,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBox Grid.Row="0"
                 x:Name="FirstMessage"
                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                 materialDesign:HintAssist.Hint="First message — Agent 开场白"
                 FontSize="13"
                 Margin="0,0,0,12" />

        <Border Grid.Row="1" Style="{StaticResource App.SoftCard}" Padding="14">
            <StackPanel>
                <TextBlock Text="预览"
                           FontWeight="SemiBold"
                           FontSize="11"
                           Foreground="{StaticResource App.TextSecondary}"
                           Margin="0,0,0,6" />
                <TextBlock Text="{Binding FirstMessage, Mode=OneWay}"
                           TextWrapping="Wrap"
                           FontSize="14"
                           Foreground="{StaticResource App.Text}" />
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="2"
                   Margin="0,14,0,4"
                   FontWeight="SemiBold"
                   FontSize="12"
                   Foreground="{StaticResource App.Text}">
            <Run Text="Local Suggestions" />
            <Run Text="(" /><Run Text="{Binding Suggestions.Count, Mode=OneWay}" /><Run Text=")" />
        </TextBlock>
    </Grid>
</UserControl>