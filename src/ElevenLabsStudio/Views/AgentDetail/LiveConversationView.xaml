<UserControl x:Class="ElevenLabsStudio.Views.AgentDetail.LiveConversationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <Grid VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0"
                Style="{StaticResource App.SectionCard}"
                Padding="0,4">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="StartAsync"
                        Style="{StaticResource App.PrimaryButton}"
                        IsEnabled="{Binding CanStart}"
                        AutomationProperties.Name="New Conversation"
                        ToolTip="Start a voice conversation with the current dynamic variables"
                        Margin="0,0,8,6">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Microphone" Width="15" Height="15" Margin="0,0,6,0" />
                        <TextBlock Text="New Conversation" />
                    </StackPanel>
                </Button>
                <Button x:Name="StopAsync"
                        Style="{StaticResource App.DangerButton}"
                        IsEnabled="{Binding CanStop}"
                        Margin="0,0,0,6">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="StopCircleOutline" Width="15" Height="15" Margin="0,0,6,0" />
                        <TextBlock Text="End" />
                    </StackPanel>
                </Button>

                <Border Style="{StaticResource App.Badge}" Margin="12,0,12,6"
                        Visibility="{Binding ShowConnectionStatus, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource App.TextMuted}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource App.Success}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource App.TextSecondary}" FontSize="11" />
                    </StackPanel>
                </Border>
                <TextBlock Text="{Binding ModeText}" Margin="0,0,14,6" VerticalAlignment="Center" Foreground="{StaticResource App.TextSecondary}" FontSize="11"
                           Visibility="{Binding ShowMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock Text="{Binding ElapsedText}" Margin="0,0,14,6" VerticalAlignment="Center" FontFamily="Consolas, Cascadia Mono, monospace" Foreground="{StaticResource App.TextSecondary}" FontSize="11"
                           Visibility="{Binding IsConnected, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </WrapPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Dynamic variables stay out of the transcript: a scenario
                 dropdown picks contact found / contact not found, and the
                 button opens the parameter dialog. Keeping the key/value
                 grid inline is what used to make this pane the tallest
                 tab, which is what made switching tabs look like a
                 resize. -->
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="Scenario"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           FontSize="12"
                           Foreground="{StaticResource App.Ink2}" />
                <ComboBox ItemsSource="{Binding VariableScenarios}"
                          SelectedItem="{Binding SelectedVariableScenario, Mode=TwoWay}"
                          DisplayMemberPath="DisplayName" IsEnabled="{Binding CanStart}"
                          Width="180" MinHeight="36" Margin="0,0,10,0"
                          ToolTip="Dynamic variables scenario" AutomationProperties.Name="Dynamic variables scenario" />
                <Button x:Name="EditDynamicVariablesAsync" Content="Set parameters"
                        Style="{StaticResource App.SecondaryButton}" IsEnabled="{Binding CanStart}"
                        AutomationProperties.Name="Set dynamic variables" />
            </WrapPanel>
        </Grid>

        <Border Grid.Row="2"
                Background="{StaticResource App.Surface}"
                BorderBrush="{StaticResource App.Line}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,10"
                Margin="0,10,0,10"
                VerticalAlignment="Stretch"
                MinWidth="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock ToolTip="{Binding ConversationId}" Text="Transcript" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource App.Text}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="ToggleMuteAsync"
                                    Content="{Binding MuteButtonText}" Style="{StaticResource App.GhostButton}"
                                    Margin="0,0,8,0" IsEnabled="{Binding IsConnected}" />
                        <Border
                                Style="{StaticResource App.Badge}"
                                Padding="7,2"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsConnected, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="Live"
                                       Foreground="{StaticResource App.TextSecondary}"
                                       FontSize="10.5"
                                       FontWeight="SemiBold" />
                        </Border>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,12,0,0">
                        <ScrollViewer x:Name="TranscriptScroll"
                                      Style="{StaticResource App.ScrollViewer}"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      ScrollChanged="OnTranscriptScrollChanged"
                                      Visibility="{Binding HasTranscript, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ItemsControl ItemsSource="{Binding Transcript}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- Turn separation comes from rhythm,
                                             not from a box per line: a flat
                                             stack with generous leading reads
                                             as one continuous conversation
                                             instead of a pile of cards. -->
                                        <StackPanel Margin="0,0,0,18">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Speaker}"
                                                           FontWeight="SemiBold"
                                                           FontSize="12"
                                                           Foreground="{StaticResource App.Text}" />
                                                <TextBlock Text="  ·  " Foreground="{StaticResource App.TextMuted}" FontSize="12" />
                                                <TextBlock Text="{Binding At, StringFormat='{}{0:HH:mm:ss}'}"
                                                           Foreground="{StaticResource App.TextMuted}"
                                                           FontSize="11" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Text}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,3,0,0"
                                                       FontSize="12.5"
                                                       LineHeight="20"
                                                       Foreground="{StaticResource App.Text}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <Border Background="{StaticResource App.SurfaceAlt}"
                                CornerRadius="8"
                                Padding="12"
                                Visibility="{Binding HasNoTranscript, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="MessageTextOutline"
                                                         Width="20"
                                                         Height="20"
                                                         HorizontalAlignment="Center"
                                                         Foreground="{StaticResource App.TextMuted}" />
                                <TextBlock Text="No transcript yet"
                                           Margin="0,4,0,0"
                                           HorizontalAlignment="Center"
                                           FontWeight="SemiBold"
                                           FontSize="13"
                                           Foreground="{StaticResource App.Text}" />
                                <TextBlock Text="Edit the variables, then select New Conversation to start speaking."
                                           Margin="0,4,0,0"
                                           HorizontalAlignment="Center"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           FontSize="11"
                                           Foreground="{StaticResource App.TextMuted}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <!-- Level meters. These used to be two full-width ProgressBars with
                         text captions, each spanning half the pane — on a
                         wide monitor they read as two long decorative
                         rules rather than a live signal. They are now a
                         compact icon + short meter cluster, stacked in the
                         bottom-right corner next to the header's own status
                         controls. The microphone icon flips to the muted
                         glyph so the state is visible without reading the
                         header button's caption. -->
                    <StackPanel Grid.Row="2"
                                Orientation="Vertical"
                                HorizontalAlignment="Right"
                                Margin="0,12,0,2">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <materialDesign:PackIcon Width="15" Height="15"
                                                     VerticalAlignment="Center"
                                                     Foreground="{StaticResource App.TextMuted}">
                                <materialDesign:PackIcon.Style>
                                    <Style TargetType="materialDesign:PackIcon">
                                        <Setter Property="Kind" Value="Microphone" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                <Setter Property="Kind" Value="MicrophoneOff" />
                                                <Setter Property="Foreground" Value="{StaticResource App.Danger}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialDesign:PackIcon.Style>
                            </materialDesign:PackIcon>
                            <ProgressBar Value="{Binding InputVolume, Mode=OneWay}"
                                         Maximum="1" Height="4" Width="96"
                                         Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="VolumeHigh"
                                                     Width="15" Height="15"
                                                     VerticalAlignment="Center"
                                                     Foreground="{StaticResource App.TextMuted}" />
                            <ProgressBar Value="{Binding OutputVolume, Mode=OneWay}"
                                         Maximum="1" Height="4" Width="96"
                                         Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

        <!-- Audio sink for the realtime WebRTC pump. Stays 1x1 in the
             transcript row; it must keep x:Name="AudioHost" because the
             live view model resolves it through the visual tree. -->
        <wv2:WebView2 x:Name="AudioHost"
                      Grid.Row="2"
                      Width="1"
                      Height="1"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Bottom"
                      IsHitTestVisible="False" />
    </Grid>
</UserControl>
