<UserControl x:Class="ElevenLabsStudio.Views.AgentDetail.WorkflowTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid Margin="0,8,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="v0.1 只读 — 编辑能力在后续迭代中加入"
                   FontSize="11"
                   Foreground="{StaticResource App.TextMuted}"
                   Margin="0,0,0,10" />

        <Border Grid.Row="1" Style="{StaticResource App.SoftCard}" Padding="0">
            <DockPanel>
                <Border DockPanel.Dock="Top"
                        Background="{StaticResource App.Surface}"
                        BorderBrush="{StaticResource App.Border}"
                        BorderThickness="0,0,0,1"
                        Padding="14,8">
                    <TextBlock Text="Nodes"
                               FontWeight="SemiBold"
                               FontSize="11"
                               Foreground="{StaticResource App.TextSecondary}" />
                </Border>
                <ListBox x:Name="Nodes"
                         MinHeight="120"
                         BorderThickness="0"
                         Background="Transparent">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesignListBoxItem}">
                            <Setter Property="Padding" Value="10,4" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Id}"
                                           FontFamily="Consolas, Cascadia Mono, monospace"
                                           FontSize="11"
                                           Foreground="{StaticResource App.TextMuted}" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Type}"
                                           FontWeight="SemiBold"
                                           FontSize="12"
                                           Foreground="{StaticResource App.Text}" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding Name}"
                                           FontSize="12"
                                           Foreground="{StaticResource App.TextSecondary}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <TextBlock Grid.Row="2"
                   Text="Raw JSON"
                   FontWeight="SemiBold"
                   FontSize="11"
                   Foreground="{StaticResource App.TextSecondary}"
                   Margin="0,12,0,4" />

        <Border Grid.Row="3" Style="{StaticResource App.SoftCard}" Padding="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto">
                <TextBox x:Name="RawJson"
                         IsReadOnly="True"
                         FontFamily="Consolas, Cascadia Mono, monospace"
                         FontSize="11"
                         BorderThickness="0"
                         Background="Transparent"
                         Foreground="{StaticResource App.TextSecondary}"
                         TextWrapping="NoWrap"
                         AcceptsReturn="True" />
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>