<UserControl x:Class="ElevenLabsStudio.Views.AgentDetail.WorkflowTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:domain="clr-namespace:ElevenLabsStudio.Core.Domain;assembly=ElevenLabsStudio.Core">
    <Grid Margin="0,12,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
        </Grid.RowDefinitions>

        <!-- Header with Add Node -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <Button x:Name="AddNode"
                    DockPanel.Dock="Right"
                    Content="+ 添加节点"
                    Height="32"
                    Padding="12,0"
                    Margin="8,0,0,0"
                    Background="{StaticResource App.Accent}"
                    Foreground="White"
                    BorderThickness="0" />
            <TextBlock Text="节点序列"
                       FontWeight="SemiBold"
                       FontSize="12"
                       Foreground="{StaticResource App.Text}"
                       VerticalAlignment="Center" />
        </DockPanel>

        <!-- Editable DataGrid -->
        <DataGrid Grid.Row="1"
                  x:Name="NodesGrid"
                  ItemsSource="{Binding Nodes}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  Background="{StaticResource App.SurfaceAlt}"
                  BorderBrush="{StaticResource App.Border}"
                  BorderThickness="1"
                  GridLinesVisibility="Horizontal"
                  RowBackground="{StaticResource App.Surface}"
                  AlternatingRowBackground="{StaticResource App.SurfaceAlt}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id"
                                    Binding="{Binding Id, UpdateSourceTrigger=PropertyChanged}"
                                    Width="120" />
                <DataGridTextColumn Header="Type"
                                    Binding="{Binding Type, UpdateSourceTrigger=PropertyChanged}"
                                    Width="140" />
                <DataGridTextColumn Header="Name"
                                    Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                    Width="*" />
                <DataGridTemplateColumn Header="" Width="56">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="✕"
                                    Click="RemoveNode_Click"
                                    Tag="{Binding}"
                                    Width="28" Height="28"
                                    Background="Transparent"
                                    Foreground="{StaticResource App.Danger}"
                                    BorderThickness="0"
                                    ToolTip="删除节点" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="2"
                   Text="Raw JSON (只读 — 真实 API 不允许在 Edit 时直接修改)"
                   FontWeight="SemiBold"
                   FontSize="12"
                   Foreground="{StaticResource App.TextSecondary}"
                   Margin="0,12,0,4" />

        <Border Grid.Row="3" Style="{StaticResource App.SoftCard}" Padding="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto">
                <TextBox x:Name="RawJson"
                         IsReadOnly="True"
                         FontFamily="Consolas, Cascadia Mono, monospace"
                         FontSize="11"
                         BorderThickness="0"
                         Background="Transparent"
                         Foreground="{StaticResource App.TextSecondary}"
                         TextWrapping="NoWrap"
                         AcceptsReturn="True" />
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>