<Window x:Class="ElevenLabsStudio.ShellView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:cal="http://www.caliburnproject.org"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="ElevenLabs Studio"
        Height="840" Width="1360"
        MinHeight="600" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="True"
        Background="Transparent"
        TextElement.Foreground="{StaticResource App.Text}"
        FontFamily="{DynamicResource MaterialDesign.Font}"
        d:DataContext="{d:DesignInstance Type=vm:ShellViewModel, IsDesignTimeCreatable=True}"
        xmlns:vm="clr-namespace:ElevenLabsStudio.ViewModels">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="52"
                            ResizeBorderThickness="8"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource App.BorderStrong}"
            BorderThickness="1"
            Background="{StaticResource App.Canvas}"
            CornerRadius="14"
            Margin="8"
            Effect="{StaticResource App.WindowShadow}">
		<Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
                <RowDefinition Height="32" />
            </Grid.RowDefinitions>

            <!-- 1. Custom title bar -->
            <Border Grid.Row="0"
                    Background="{StaticResource App.Surface}"
                    BorderBrush="{StaticResource App.Border}"
                    BorderThickness="0,0,0,1">
                <DockPanel LastChildFill="True">
                    <!-- Left: brand -->
                    <StackPanel DockPanel.Dock="Left"
                                Orientation="Horizontal"
                                Margin="18,0,0,0"
                                VerticalAlignment="Center">
                        <Border Width="30" Height="30"
                                CornerRadius="9"
                                Background="{StaticResource App.Accent}">
                            <materialDesign:PackIcon Kind="MicrophoneOutline"
                                                     Width="17" Height="17"
                                                     Foreground="White"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="ElevenLabs Studio"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Margin="11,0,0,0"
                                   VerticalAlignment="Center" />
                        <Border Style="{StaticResource App.Badge}"
                                Padding="7,2"
                                Margin="10,0,0,0">
                            <TextBlock Text="v0.1"
                                       FontSize="10"
                                       Foreground="{StaticResource App.Accent}" />
                        </Border>
                    </StackPanel>

                    <!-- Right: caption buttons -->
                    <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal"
                                Margin="0,0,0,0">
                        <Button x:Name="OpenSettings"
                                cal:Message.Attach="[Event Click] = [Action OpenSettingsAsync()]"
                                Style="{StaticResource CaptionButton}"
                                Margin="2,3"
                                ToolTip="设置"
                                AutomationProperties.Name="设置">
                            <materialDesign:PackIcon Kind="CogOutline"
                                                     Width="14" Height="14" />
                        </Button>
                        <Button x:Name="Minimize"
                                Style="{StaticResource CaptionButton}"
                                Margin="2,3"
                                ToolTip="最小化">
                            <materialDesign:PackIcon Kind="WindowMinimize"
                                                     Width="14" Height="14" />
                        </Button>
                        <Button x:Name="MaximizeRestore"
                                Style="{StaticResource CaptionButton}"
                                Margin="2,3"
                                ToolTip="最大化">
                            <materialDesign:PackIcon x:Name="MaximizeIcon"
                                                     Kind="WindowMaximize"
                                                     Width="14" Height="14" />
                        </Button>
                        <Button x:Name="CloseWindow"
                                Style="{StaticResource CaptionButton}"
                                Margin="2,3,6,3"
                                Foreground="{StaticResource App.Danger}"
                                ToolTip="关闭">
                            <materialDesign:PackIcon Kind="Close"
                                                     Width="14" Height="14" />
                        </Button>
                    </StackPanel>

                    <!-- Middle: drag handle (empty Grid lets WindowChrome
                         pick up drag via CaptionHeight, no extra handler
                         needed). -->
                    <Grid />
                </DockPanel>
            </Border>

            <!-- 2. Main split -->
            <Grid Grid.Row="1" Margin="20,18,20,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="310" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left: agent menu (borderless card) -->
                <ContentControl Grid.Column="0"
                                cal:View.Model="{Binding AgentsVm}"
                                Margin="0,0,16,0" />

                <!-- Right: detail panel. The DataContextChanged code-behind
                     handler resolves the right view for whatever VM
                     the ShellViewModel hands us (placeholder or
                     4-tab detail). This is the simplest reliable
                     route — cal:View.Model nested in a Border
                     never re-rendered the view. -->
                <Border x:Name="DetailBorder"
                        Grid.Column="1"
                        Style="{StaticResource App.ElevatedCard}">
                    <ContentControl x:Name="DetailHost"
                                    DataContext="{Binding AgentDetail}"
                                    DataContextChanged="DetailHost_DataContextChanged"
                                    Loaded="DetailHost_Loaded" />
                </Border>
            </Grid>

            <!-- 3. Status bar -->
            <Border Grid.Row="2"
                    Background="{StaticResource App.Surface}"
                    BorderBrush="{StaticResource App.Border}"
                    BorderThickness="0,1,0,0">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Right"
                               Text="{Binding CurrentTime, StringFormat='{}{0:HH:mm:ss}'}"
                               VerticalAlignment="Center"
                               Margin="0,0,16,0"
                               FontSize="11"
                               Foreground="{StaticResource App.TextMuted}" />
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="16,0,0,0">
                        <ProgressBar Style="{DynamicResource MaterialDesign.LinearProgressBar}"
                                     Width="80"
                                     Height="2"
                                     IsIndeterminate="True"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                                     Margin="0,0,8,0" />
                        <TextBlock Text="{Binding BusyMessage}"
                                   FontSize="11"
                                   Foreground="{StaticResource App.TextSecondary}" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
