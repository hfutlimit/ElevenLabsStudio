<Window x:Class="ElevenLabsStudio.ShellView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:cal="http://www.caliburnproject.org"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="ElevenLabs Studio"
        Height="820" Width="1320"
        MinHeight="600" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="True"
        Background="Transparent"
        TextElement.Foreground="{StaticResource App.Text}"
        FontFamily="{DynamicResource MaterialDesign.Font}"
        d:DataContext="{d:DesignInstance Type=vm:ShellViewModel, IsDesignTimeCreatable=True}"
        xmlns:vm="clr-namespace:ElevenLabsStudio.ViewModels">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <!-- Outer border = single-pixel rounded-rect outline of the window. -->
    <Border BorderBrush="{StaticResource App.Border}"
            BorderThickness="1"
            Background="{StaticResource App.Surface}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
                <RowDefinition Height="28" />
            </Grid.RowDefinitions>

            <!-- 1. Custom title bar -->
            <Border Grid.Row="0"
                    Background="{StaticResource App.Surface}"
                    BorderBrush="{StaticResource App.Border}"
                    BorderThickness="0,0,0,1">
                <DockPanel LastChildFill="True">
                    <!-- Left: brand -->
                    <StackPanel DockPanel.Dock="Left"
                                Orientation="Horizontal"
                                Margin="14,0,0,0"
                                VerticalAlignment="Center">
                        <Border Width="22" Height="22"
                                CornerRadius="4"
                                Background="{StaticResource App.Accent}">
                            <TextBlock Text="🎙"
                                       FontSize="13"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="ElevenLabs Studio"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center" />
                        <Border Background="#EEF2FF"
                                CornerRadius="3"
                                Padding="6,2"
                                Margin="10,0,0,0">
                            <TextBlock Text="v0.1"
                                       FontSize="10"
                                       Foreground="{StaticResource App.Accent}" />
                        </Border>
                    </StackPanel>

                    <!-- Right: caption buttons -->
                    <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal"
                                Margin="0,0,0,0">
                        <Button x:Name="OpenSettings"
                                Style="{StaticResource CaptionButton}"
                                ToolTip="设置">
                            <materialDesign:PackIcon Kind="CogOutline"
                                                     Width="14" Height="14" />
                        </Button>
                        <Button x:Name="Minimize"
                                Style="{StaticResource CaptionButton}"
                                ToolTip="最小化">
                            <materialDesign:PackIcon Kind="WindowMinimize"
                                                     Width="14" Height="14" />
                        </Button>
                        <Button x:Name="MaximizeRestore"
                                Style="{StaticResource CaptionButton}"
                                ToolTip="最大化">
                            <materialDesign:PackIcon x:Name="MaximizeIcon"
                                                     Kind="WindowMaximize"
                                                     Width="14" Height="14" />
                        </Button>
                        <Button x:Name="Close"
                                Style="{StaticResource CaptionButton}"
                                ToolTip="关闭">
                            <materialDesign:PackIcon Kind="Close"
                                                     Width="14" Height="14" />
                        </Button>
                    </StackPanel>

                    <!-- Middle: drag handle (empty Grid lets WindowChrome
                         pick up drag via CaptionHeight, no extra handler
                         needed). -->
                    <Grid />
                </DockPanel>
            </Border>

            <!-- 2. Main split -->
            <Grid Grid.Row="1" Margin="16,14,16,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left: agent menu (borderless card) -->
                <ContentControl Grid.Column="0"
                                cal:View.Model="{Binding AgentsVm}"
                                Margin="0,0,12,0" />

                <!-- Right: detail panel. Code-behind assigns the view
                     directly when the bound VM changes — we gave up on
                     the nested ContentControl + cal:View.Model
                     auto-locate because CM5 doesn't reliably rebuild
                     views inside an already-initialised Border. -->
                <Border x:Name="DetailBorder"
                        Grid.Column="1"
                        BorderBrush="{StaticResource App.Border}"
                        BorderThickness="1"
                        Background="{StaticResource App.Surface}"
                        CornerRadius="4">
                    <ContentControl x:Name="DetailHost" />
                </Border>
            </Grid>

            <!-- 3. Status bar -->
            <Border Grid.Row="2"
                    Background="{StaticResource App.SurfaceAlt}"
                    BorderBrush="{StaticResource App.Border}"
                    BorderThickness="0,1,0,0">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Right"
                               Text="{Binding CurrentTime, StringFormat='{}{0:HH:mm:ss}'}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"
                               FontSize="11"
                               Foreground="{StaticResource App.TextMuted}" />
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="12,0,0,0">
                        <ProgressBar Style="{DynamicResource MaterialDesign.LinearProgressBar}"
                                     Width="80"
                                     Height="2"
                                     IsIndeterminate="True"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                                     Margin="0,0,8,0" />
                        <TextBlock Text="{Binding BusyMessage}"
                                   FontSize="11"
                                   Foreground="{StaticResource App.TextSecondary}" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>