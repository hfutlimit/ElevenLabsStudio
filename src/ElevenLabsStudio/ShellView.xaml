<Window x:Class="ElevenLabsStudio.ShellView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:cal="http://www.caliburnproject.org"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:ElevenLabsStudio.ViewModels"
        mc:Ignorable="d"
        Title="ElevenLabs Studio"
        Height="840" Width="1360"
        MinHeight="600" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource App.Canvas}"
        TextElement.Foreground="{StaticResource App.Text}"
        FontFamily="{StaticResource App.UiFont}"
        d:DataContext="{d:DesignInstance Type=vm:ShellViewModel, IsDesignTimeCreatable=True}">

    <!-- Route B rebuild (see docs/prototypes/2026-09-24-redesign-review.md):
         the window IS the surface. No outer card, no shadow, no
         AllowsTransparency (see review §8 — the DWM composite penalty
         and the "floating dark edge while maximized" bug from §7 were
         both downstream of that one flag). WindowChrome still owns the
         caption bar; hairline frame + 46px title bar matches the
         prototype. -->

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="56"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="RootFrame"
            BorderBrush="{StaticResource App.Frame}"
            BorderThickness="1"
            Background="{StaticResource App.Canvas}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 1. Title bar: brand + crumb on the left, status + caption
                     buttons on the right. One hairline under it, no card
                     chrome anywhere. -->
            <Border Grid.Row="0"
                    Background="{StaticResource App.Canvas}"
                    BorderBrush="{StaticResource App.Line}"
                    BorderThickness="0,0,0,1">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Left"
                                Orientation="Horizontal"
                                Margin="25,0,0,0"
                                VerticalAlignment="Center">
                        <!-- ElevenLabs wordmark: two ink bars, the
                             prototype's .brand-mark. -->
                        <StackPanel Orientation="Horizontal"
                                    Width="20"
                                    VerticalAlignment="Center">
                            <Rectangle Width="4" Height="20" Fill="{StaticResource App.Text}" />
                            <Rectangle Width="4" Height="20" Margin="4,0,0,0" Fill="{StaticResource App.Text}" />
                        </StackPanel>
                        <TextBlock Margin="11,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource App.Text}"><Run Text="ElevenLabs "/><Run Text="Studio" FontWeight="Normal" /></TextBlock>
                        <TextBlock Text="api.elevenlabs.io"
                                   FontFamily="{StaticResource App.MonoFont}"
                                   FontSize="10"
                                   Foreground="{StaticResource App.Ink3}"
                                   Margin="20,1,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Caption buttons. -->
                    <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal"
                                VerticalAlignment="Stretch"
                                Margin="0,0,0,0">
                        <Button x:Name="OpenSettings"
                                cal:Message.Attach="[Event Click] = [Action OpenSettingsAsync()]"
                                Style="{StaticResource CaptionButton}"
                                ToolTip="Settings"
                                AutomationProperties.Name="Settings">
                            <materialDesign:PackIcon Kind="CogOutline"
                                                     Width="16" Height="16" />
                        </Button>
                        <Button x:Name="Minimize"
                                Style="{StaticResource CaptionButton}"
                                ToolTip="Minimize">
                            <materialDesign:PackIcon Kind="WindowMinimize"
                                                     Width="16" Height="16" />
                        </Button>
                        <Button x:Name="MaximizeRestore"
                                Style="{StaticResource CaptionButton}"
                                ToolTip="Maximize">
                            <materialDesign:PackIcon x:Name="MaximizeIcon"
                                                     Kind="WindowMaximize"
                                                     Width="16" Height="16" />
                        </Button>
                        <Button x:Name="CloseWindow"
                                Style="{StaticResource CloseCaptionButton}"
                                ToolTip="Close">
                            <materialDesign:PackIcon Kind="Close"
                                                     Width="16" Height="16" />
                        </Button>
                    </StackPanel>

                    <!-- Busy indicator: a slim bar, only when IsBusy. -->
                    <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,10,0">
                        <ProgressBar Style="{DynamicResource MaterialDesign.LinearProgressBar}"
                                     Width="56" Height="2"
                                     IsIndeterminate="True"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                                     Margin="0,0,8,0"
                                     VerticalAlignment="Center" />
                        <TextBlock Text="{Binding BusyMessage}"
                                   FontSize="11"
                                   MaxWidth="280"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                                   Foreground="{StaticResource App.Ink2}" />
                    </StackPanel>

                    <!-- Drag handle for WindowChrome. -->
                    <Grid />
                </DockPanel>
            </Border>

            <!-- 2. Body: sidebar rail + one hairline + detail. -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SidebarColumn" Width="260" MinWidth="48" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left sidebar. AgentListView renders the flat panel;
                     the collapse toggle is pinned on top of it so the
                     rail keeps its full width when collapsed. -->
                <Grid Grid.Column="0">
                    <ContentControl x:Name="SidebarHost"
                                    cal:View.Model="{Binding AgentsVm}" />

                    <Border x:Name="CollapsedSidebarRail"
                            Background="{StaticResource App.Side}"
                            BorderBrush="{StaticResource App.Line}"
                            BorderThickness="0,0,1,0"
                            Visibility="Collapsed">
                        <StackPanel Margin="0,60,0,0" HorizontalAlignment="Center">
                            <Border Width="28" Height="28"
                                    CornerRadius="6"
                                    Background="{StaticResource App.SignalWash}"
                                    BorderBrush="{StaticResource App.Line}"
                                    BorderThickness="1"
                                    ToolTip="Agents">
                                <materialDesign:PackIcon Kind="RobotOutline"
                                                         Width="15" Height="15"
                                                         Foreground="{StaticResource App.Signal}"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Collapse toggle, pinned to the top-right of the
                         sidebar column. Sits above both the expanded
                         AgentListView and the compact rail so its
                         position never jumps between states. -->
                    <Button x:Name="SidebarToggle"
                            Panel.ZIndex="4"
                            Width="28" Height="28"
                            Margin="0,12,12,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Style="{StaticResource App.IconButton}"
                            ToolTip="Collapse agents sidebar"
                            AutomationProperties.Name="Collapse agents sidebar">
                        <materialDesign:PackIcon x:Name="SidebarToggleIcon"
                                                 Kind="ChevronLeft"
                                                 Width="14" Height="14" />
                    </Button>
                </Grid>

                <!-- Right pane. AgentDetailView owns its own header,
                     underline tab strip, scrollable content, and sticky
                     action footer — so this is just a hairline frame
                     with a stretch ContentControl inside. -->
                <Border Grid.Column="1"
                        Background="{StaticResource App.Canvas}"
                        BorderBrush="{StaticResource App.Line}"
                        BorderThickness="1,0,0,0">
                    <ContentControl x:Name="DetailHost"
                                    DataContext="{Binding AgentDetail}"
                                    DataContextChanged="DetailHost_DataContextChanged"
                                    Loaded="DetailHost_Loaded"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch" />
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
