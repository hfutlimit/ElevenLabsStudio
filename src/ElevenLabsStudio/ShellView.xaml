<Window x:Class="ElevenLabsStudio.ShellView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:cal="http://www.caliburnproject.org"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="ElevenLabs Studio"
        Height="840" Width="1360"
        MinHeight="600" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="True"
        Background="Transparent"
        TextElement.Foreground="{StaticResource App.Text}"
        FontFamily="{DynamicResource MaterialDesign.Font}"
        d:DataContext="{d:DesignInstance Type=vm:ShellViewModel, IsDesignTimeCreatable=True}"
        xmlns:vm="clr-namespace:ElevenLabsStudio.ViewModels">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="52"
                            ResizeBorderThickness="8"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource App.BorderEmphasis}"
            BorderThickness="1"
            Background="{StaticResource App.Canvas}"
            CornerRadius="14"
            Margin="8"
            Effect="{StaticResource App.WindowShadow}">
		<Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 1. Custom title bar -->
            <Border Grid.Row="0"
                    Background="{StaticResource App.Surface}"
                    BorderBrush="{StaticResource App.Border}"
                    BorderThickness="0,0,0,1">
                <DockPanel LastChildFill="True">
                    <!-- Left: brand -->
                    <StackPanel DockPanel.Dock="Left"
                                Orientation="Horizontal"
                                Margin="18,0,0,0"
                                VerticalAlignment="Center">
                        <Border Width="26" Height="26"
                                CornerRadius="8"
                                Background="{StaticResource App.Accent}">
                            <materialDesign:PackIcon Kind="MicrophoneOutline"
                                                     Width="15" Height="15"
                                                     Foreground="White"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="ElevenLabs Studio"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Right: caption buttons -->
                    <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal"
                                Margin="0,0,0,0">
                        <Button x:Name="OpenSettings"
                                cal:Message.Attach="[Event Click] = [Action OpenSettingsAsync()]"
                                Style="{StaticResource CaptionButton}"
                                Margin="2,3"
                                ToolTip="Settings"
                                AutomationProperties.Name="Settings">
                            <materialDesign:PackIcon Kind="CogOutline"
                                                     Width="14" Height="14" />
                        </Button>
                        <Button x:Name="Minimize"
                                Style="{StaticResource CaptionButton}"
                                Margin="2,3"
                                ToolTip="Minimize">
                            <materialDesign:PackIcon Kind="WindowMinimize"
                                                     Width="14" Height="14" />
                        </Button>
                        <Button x:Name="MaximizeRestore"
                                Style="{StaticResource CaptionButton}"
                                Margin="2,3"
                                ToolTip="Maximize">
                            <materialDesign:PackIcon x:Name="MaximizeIcon"
                                                     Kind="WindowMaximize"
                                                     Width="14" Height="14" />
                        </Button>
                        <Button x:Name="CloseWindow"
                                Style="{StaticResource CaptionButton}"
                                Margin="2,3,6,3"
                                Foreground="{StaticResource App.Danger}"
                                ToolTip="Close">
                            <materialDesign:PackIcon Kind="Close"
                                                     Width="14" Height="14" />
                        </Button>
                    </StackPanel>

                    <!-- Busy indicator (docked right, sits left of the
                         caption buttons). No bottom status bar: the
                         window belongs to the content. -->
                    <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,14,0">
                        <ProgressBar Style="{DynamicResource MaterialDesign.LinearProgressBar}"
                                     Width="56" Height="2"
                                     IsIndeterminate="True"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                                     Margin="0,0,8,0"
                                     VerticalAlignment="Center" />
                        <TextBlock Text="{Binding BusyMessage}"
                                   FontSize="11"
                                   MaxWidth="280"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource App.TextSecondary}" />
                    </StackPanel>

                    <!-- Middle: drag handle (empty Grid lets WindowChrome
                         pick up drag via CaptionHeight, no extra handler
                         needed). -->
                    <Grid />
                </DockPanel>
            </Border>

            <!-- 2. Main split -->
            <Grid Grid.Row="1" Margin="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SidebarColumn" Width="310" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left: agent menu and compact rail share one column. -->
                <ContentControl x:Name="SidebarHost"
                                Grid.Column="0"
                                cal:View.Model="{Binding AgentsVm}" />

                <Border x:Name="CollapsedSidebarRail"
                        Grid.Column="0"
                        Style="{StaticResource App.ElevatedCard}"
                        Visibility="Collapsed">
                    <StackPanel Margin="0,16" HorizontalAlignment="Center">
                        <Border Width="32" Height="32"
                                CornerRadius="8"
                                Background="{StaticResource App.AccentSoft}"
                                BorderBrush="{StaticResource App.AccentBorder}"
                                BorderThickness="1"
                                ToolTip="Agents">
                            <materialDesign:PackIcon Kind="RobotOutline"
                                                     Width="17" Height="17"
                                                     Foreground="{StaticResource App.Accent}"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>
                </Border>

                <Button x:Name="SidebarToggle"
                        Grid.Column="1"
                        Panel.ZIndex="4"
                        Width="28" Height="28"
                        Margin="0,14,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Style="{StaticResource App.IconButton}"
                        ToolTip="Collapse agents sidebar"
                        AutomationProperties.Name="Collapse agents sidebar">
                    <materialDesign:PackIcon x:Name="SidebarToggleIcon"
                                             Kind="ChevronLeft"
                                             Width="16" Height="16" />
                </Button>

                <!-- Right: detail panel. The DataContextChanged code-behind
                     handler resolves the right view for whatever VM
                     the ShellViewModel hands us (placeholder or
                     4-tab detail). This is the simplest reliable
                     route — cal:View.Model nested in a Border
                     never re-rendered the view. -->
                <Border x:Name="DetailBorder"
                        Grid.Column="2"
                        Style="{StaticResource App.ElevatedCard}">
                    <ContentControl x:Name="DetailHost"
                                    DataContext="{Binding AgentDetail}"
                                    DataContextChanged="DetailHost_DataContextChanged"
                                    Loaded="DetailHost_Loaded" />
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
