<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- System.Drawing is Windows-only; net10.0-windows keeps the
         compiler from nagging us with cross-platform CA1416 warnings. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>ElevenLabsStudio.Tools.IconGen</RootNamespace>
    <AssemblyName>IconGen</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
  </ItemGroup>

</Project>